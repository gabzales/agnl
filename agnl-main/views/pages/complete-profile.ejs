<%
const pageTitle = 'Lengkapi Profil';
const noIndex = true; // halaman privat user, jangan di-index Google
%>

<style>
  /* FIX (dark mode, 23 Agu 2026) */
  .text-zinc-400, .text-zinc-600 { color: var(--text-2) !important; }
</style>

<script>
if (typeof window !== 'undefined') {
  document.body.classList.add('auth-page');
  window.addEventListener('load', () => document.body.classList.add('auth-page'));
}
</script>

<div class="min-h-screen flex items-center justify-center px-4 py-20" style="background:var(--bg-main);">
    <div class="w-full max-w-md">
        <div class="text-center mb-8">
            <% if (settings?.logoUrl) { %>
            <img src="<%= settings.logoUrl %>" alt="Logo" class="h-14 w-auto mx-auto mb-4" style="object-fit:contain;">
            <% } else { %>
            <div class="w-14 h-14 rounded-xl flex items-center justify-center mx-auto mb-4" style="background:var(--blue);">
                <iconify-icon icon="mdi:account-check" style="color:#fff;font-size:28px;"></iconify-icon>
            </div>
            <% } %>
            <h1 style="font-family:'Inter',sans-serif;font-weight:900;font-size:20px;color:var(--text-1);letter-spacing:.01em;margin-bottom:8px;">Satu langkah lagi!</h1>
            <p class="text-sm" style="color:var(--text-3);">Selamat datang, <%= user?.username || '' %>! Isi nomor WhatsApp kamu untuk menerima notifikasi key & transaksi.</p>
        </div>

        <div class="card rounded-xl overflow-hidden">
            <div class="p-6">
                <div id="errBox" class="mb-4 p-3 rounded-lg bg-red-500/10 border border-red-500/30 items-center gap-2 hidden">
                    <iconify-icon icon="mdi:alert-circle" class="text-red-400 text-lg"></iconify-icon>
                    <span class="text-xs text-red-400" id="errText"></span>
                </div>

                <form id="cpForm" class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 mb-2">No. WhatsApp</label>
                        <div class="relative">
                            <iconify-icon icon="mdi:whatsapp" class="absolute left-3 top-1/2 -translate-y-1/2 text-green-500"></iconify-icon>
                            <input type="tel" name="wa" required class="form-input pl-10" placeholder="08xxxxxxxxxx" pattern="[0-9]+" maxlength="15" autofocus>
                        </div>
                        <p class="text-[10px] text-zinc-600 mt-1 ml-1">Format: 08xxx atau 628xxx. Dipakai untuk kirim key & notifikasi transaksi.</p>
                    </div>

                    <button type="submit" id="cpBtn" class="w-full py-2.5 rounded-lg text-white text-xs font-bold flex items-center justify-center gap-2 shadow-md shadow-emerald-500/20" style="background:#dc2626;">
                        <iconify-icon icon="mdi:check-circle" class="text-base"></iconify-icon>
                        <span>Lanjutkan</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('cpForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const btn = document.getElementById('cpBtn');
    const errBox = document.getElementById('errBox');
    const errText = document.getElementById('errText');
    errBox.classList.add('hidden');
    btn.disabled = true;
    const fd = new FormData(this);
    try {
        const res = await fetch('/complete-profile', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ wa: fd.get('wa') }) });
        const data = await res.json();
        if (data.success) {
            window.location.href = '/';
        } else {
            errText.textContent = data.message || 'Gagal menyimpan';
            errBox.classList.remove('hidden');
            btn.disabled = false;
        }
    } catch (err) {
        errText.textContent = 'Koneksi error: ' + err.message;
        errBox.classList.remove('hidden');
        btn.disabled = false;
    }
});
</script>
