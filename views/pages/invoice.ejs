<%
const pageTitle = 'Cek Pesanan';
const noIndex = true; // halaman privat user, jangan di-index Google
%>

<style>
    .text-white { color: #18181b !important; }
    .text-white\/70 { color: rgba(24,24,27,.75) !important; }
    .text-white\/60 { color: rgba(24,24,27,.65) !important; }
    .text-white\/40 { color: rgba(24,24,27,.45) !important; }
    .hover\:text-white:hover { color: #18181b !important; }

    /* FIX (dark mode, 23 Agu 2026): override tambahan untuk html.dark --
       file ini dipaksa terang oleh blok di atas, jadi perlu override
       kedua supaya ikut gelap lagi saat toggle diaktifkan. Juga
       menyasar text-zinc-*/bg-white/border-zinc yang belum masuk
       override lama. */
    html.dark .text-white,
    html.dark .text-white\/70,
    html.dark .text-white\/60,
    html.dark .text-white\/40 { color: var(--text-1) !important; }
    html.dark .hover\:text-white:hover { color: var(--text-1) !important; }
    .text-zinc-300, .text-zinc-400, .text-zinc-500 { color: var(--text-2) !important; }
    .border-zinc-200 { border-color: var(--border) !important; }
    .bg-white { background: var(--bg-card) !important; }
</style>

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md border-b border-zinc-200" style="background:var(--bg-main);">
    <div class="max-w-7xl mx-auto px-4">
        <div class="flex items-center justify-between h-16">
            <a href="/" class="flex items-center gap-3">
                <img src="<%= settings?.logoUrl || '/uploads/logo-main.png' %>" alt="Logo" class="object-contain" style="height:40px;width:40px;">
                <span class="font-bold text-xl font-bold" style="color:var(--accent-color);"><%= settings.siteName || 'AGHA NL' %></span>
            </a>
            <a href="/" class="text-xs font-medium text-zinc-400 hover:text-white transition-colors">
                <iconify-icon icon="mdi:arrow-left" class="text-sm"></iconify-icon> Kembali
            </a>
        </div>
    </div>
</nav>

<div class="min-h-screen pt-20 pb-10 px-4">
    <div class="max-w-lg mx-auto">
        <div class="bg-white rounded-xl border border-zinc-200 shadow-sm overflow-hidden">
            <div class="flex items-center justify-between px-5 py-4 border-b border-zinc-100">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <iconify-icon icon="mdi:package-variant-closed" class="text-red-400"></iconify-icon> Cek Pesanan
                </h3>
            </div>

            <div class="p-5 space-y-4">
                <p class="text-xs text-zinc-500 leading-relaxed">
                    Masukkan <strong class="text-red-400">Kode Pesanan</strong> yang Anda dapatkan saat pembelian.
                </p>

                <form method="POST" action="/invoice" class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 mb-2">Kode Pesanan</label>
                        <input type="text" name="code" required class="form-input uppercase font-mono tracking-wider" placeholder="Contoh: FX-A1B2-C3D4" maxlength="14" autofocus>
                    </div>

                    <% if (error) { %>
                        <div class="p-3 rounded-lg bg-red-500/10 border border-red-500/30 flex items-center gap-2">
                            <iconify-icon icon="mdi:alert-circle" class="text-red-400 text-lg"></iconify-icon>
                            <span class="text-xs text-red-400"><%= error %></span>
                        </div>
                    <% } %>

                    <% if (transaction) { %>
                        <div class="p-4 rounded-lg bg-red-500/10 border border-red-500/20 space-y-3">
                            <div class="flex items-center justify-between">
                                <span class="text-xs text-zinc-400">Status</span>
                                <% if (transaction.status === 'done') { %>
                                    <span class="status-badge status-done">SELESAI</span>
                                <% } else if (transaction.status === 'pending') { %>
                                    <span class="status-badge status-pending">PENDING</span>
                                <% } else { %>
                                    <span class="status-badge status-cancelled">BATAL</span>
                                <% } %>
                            </div>

                            <div class="flex items-center justify-between">
                                <span class="text-xs text-zinc-400">Produk</span>
                                <span class="text-xs text-white font-medium"><%= transaction.productName %></span>
                            </div>

                            <div class="flex items-center justify-between">
                                <span class="text-xs text-zinc-400">Durasi</span>
                                <span class="text-xs text-white font-medium"><%= transaction.duration %></span>
                            </div>

                            <% if (transaction.originalPrice && transaction.voucherDiscount) { %>
                            <div class="flex items-center justify-between">
                                <span class="text-xs text-zinc-400">Harga Awal</span>
                                <span class="text-xs text-zinc-500 line-through">Rp <%= transaction.originalPrice.toLocaleString('id-ID') %></span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-xs text-zinc-400">Voucher</span>
                                <span class="text-xs font-bold text-emerald-400">-Rp <%= transaction.voucherDiscount.toLocaleString('id-ID') %></span>
                            </div>
                            <% } %>

                            <div class="flex items-center justify-between">
                                <span class="text-xs text-zinc-400">Total</span>
                                <span class="text-xs text-red-400 font-bold">Rp <%= transaction.price.toLocaleString('id-ID') %></span>
                            </div>

                            <div class="flex items-center justify-between">
                                <span class="text-xs text-zinc-400">Waktu</span>
                                <span class="text-xs text-zinc-300"><%= transaction.time %></span>
                            </div>

                            <% if (transaction.status === 'done' && transaction.key) { %>
                                <div class="pt-3 border-t border-zinc-100">
                                    <span class="text-xs text-zinc-400 block mb-2">Key/Lisensi:</span>
                                    <div class="p-3 rounded-lg bg-black/30 border border-emerald-500/30">
                                        <code id="keyDisplay" class="text-sm text-emerald-400 font-mono break-all font-black">
                                            <%= transaction.key %><% if (transaction.selectedDays) { %> — <%= transaction.selectedDays %> <%= transaction.selectedUnit === 'h' ? 'Jam' : 'Hari' %><% } %>
                                        </code>
                                    </div>
                                    <button onclick="copyKey()" id="copyKeyBtn"
                                        class="mt-2 w-full py-2 rounded-lg flex items-center justify-center gap-2 text-xs font-bold transition-all"
                                        style="background:rgba(52,211,153,.12);border:1px solid rgba(52,211,153,.3);color:#34d399;">
                                        <iconify-icon icon="mdi:content-copy"></iconify-icon>
                                        <span id="copyBtnText">Salin Key</span>
                                    </button>
                                    <script>
                                    function copyKey() {
                                        const raw = `<%= transaction.key %><% if (transaction.selectedDays) { %> — <%= transaction.selectedDays %> <%= transaction.selectedUnit === 'h' ? 'Jam' : 'Hari' %><% } %>`;
                                        navigator.clipboard.writeText(raw).then(() => {
                                            const btn = document.getElementById('copyKeyBtn');
                                            const txt = document.getElementById('copyBtnText');
                                            btn.style.background = 'rgba(52,211,153,.25)';
                                            txt.textContent = 'Tersalin!';
                                            setTimeout(() => { btn.style.background = 'rgba(52,211,153,.12)'; txt.textContent = 'Salin Key'; }, 2000);
                                        }).catch(() => {
                                            const r = document.createRange();
                                            r.selectNode(document.getElementById('keyDisplay'));
                                            window.getSelection().removeAllRanges();
                                            window.getSelection().addRange(r);
                                        });
                                    }
                                    </script>

                                    <% if (typeof productChannelUrl !== 'undefined' && productChannelUrl) { %>
                                    <a href="<%= productChannelUrl %>" target="_blank" rel="noopener"
                                        class="mt-2 w-full py-2.5 rounded-lg flex items-center justify-center gap-2 text-xs font-bold transition-all"
                                        style="background:var(--neon-purple-12);border:1px solid var(--neon-purple-25);color:var(--accent-color);">
                                        <iconify-icon icon="mdi:download-circle"></iconify-icon>
                                        Download / Join Channel <%= transaction.productName %>
                                    </a>
                                    <% } %>

                                    <% if (settings?.buyerGroupUrl) { %>
                                    <a href="<%= settings.buyerGroupUrl %>" target="_blank" rel="noopener"
                                        class="mt-2 w-full py-2.5 rounded-lg flex items-center justify-center gap-2 text-xs font-bold transition-all"
                                        style="background:rgba(37,211,102,.12);border:1px solid rgba(37,211,102,.35);color:#4ade80;">
                                        <iconify-icon icon="mdi:whatsapp" class="text-sm"></iconify-icon>
                                        Gabung Grup <%= settings.buyerGroupName || 'Buyer VIP' %>
                                    </a>
                                    <% } %>

                                    <!-- HUBUNGI CS (diminta client) -- beda dari tombol "Gabung Grup"
                                         di atas (join komunitas). Ini untuk kalau ada kendala SPESIFIK
                                         dengan transaksi/key yang baru diterima, pesan WA sudah terisi
                                         kode pesanan otomatis. -->
                                    <a href="https://wa.me/<%= (settings.contact?.whatsapp || '').replace(/\D/g,'') %>?text=<%= encodeURIComponent('Halo min, saya butuh bantuan untuk pesanan kode: ' + transaction.code) %>"
                                        target="_blank" rel="noopener"
                                        class="mt-2 w-full py-2.5 rounded-lg flex items-center justify-center gap-2 text-xs font-bold transition-all"
                                        style="background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);color:#f87171;">
                                        <iconify-icon icon="mdi:message-alert-outline" class="text-sm"></iconify-icon>
                                        Ada Kendala dengan Pesanan? Hubungi CS
                                    </a>
                                </div>
                            <% } else if (transaction.status === 'done' && transaction.outOfStock) { %>
                                <div class="pt-3 border-t border-zinc-100">
                                    <div class="p-3 rounded-lg bg-amber-500/10 border border-amber-500/30 flex items-start gap-2">
                                        <iconify-icon icon="mdi:clock-alert-outline" class="text-amber-400 text-base mt-0.5"></iconify-icon>
                                        <span class="text-xs text-amber-300">Pembayaran sudah diterima, namun stok produk sedang kosong. Admin akan segera memproses dan mengirimkan key kamu manual via WhatsApp.</span>
                                    </div>
                                    <!-- HUBUNGI CS -- khusus kasus outOfStock ini, tombol CS lebih
                                         penting muncul karena user perlu tindak lanjut manual admin. -->
                                    <a href="https://wa.me/<%= (settings.contact?.whatsapp || '').replace(/\D/g,'') %>?text=<%= encodeURIComponent('Halo min, pesanan saya kode ' + transaction.code + ' sudah dibayar tapi stok kosong. Mohon diproses ya.') %>"
                                        target="_blank" rel="noopener"
                                        class="mt-2 w-full py-2.5 rounded-lg flex items-center justify-center gap-2 text-xs font-bold transition-all"
                                        style="background:rgba(34,197,94,.12);border:1px solid rgba(34,197,94,.3);color:#4ade80;">
                                        <iconify-icon icon="mdi:whatsapp" class="text-sm"></iconify-icon>
                                        Hubungi CS via WhatsApp
                                    </a>
                                </div>
                            <% } %>
                        </div>
                    <% } %>

                    <button type="submit" class="btn-primary w-full flex items-center justify-center gap-2">
                        <iconify-icon icon="mdi:magnify" class="text-base"></iconify-icon>
                        <span>Cek Status</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
