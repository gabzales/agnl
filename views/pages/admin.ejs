function openEditProductModal(id, name, category, description, imageUrl, pricing, keyCount, status, channelUrl = '', downloadUrl = '', fakeSold = '', strikePrice = '') {
    document.getElementById('editProductId').value = id;
    document.getElementById('modalProductTitle').innerHTML = '<iconify-icon icon="mdi:pencil" class="text-yellow-400"></iconify-icon> Edit Produk';
    document.getElementById('prodSubmitLabel').textContent = 'Simpan Perubahan';
    document.getElementById('prodName').value = name||'';
    document.getElementById('prodDesc').value = description||'';
    document.getElementById('prodImageUrl').value = imageUrl||'';
    document.getElementById('prodKeys').value = '';
    document.getElementById('prodKeyCount').textContent = `${keyCount} key aktif`;
    document.getElementById('keysModeRow').style.display = 'flex';
    // Set multi-select categories (the old #prodCategory <select> no longer exists).
    let selectedCategories = category;
    if (typeof selectedCategories === 'string') {
        try {
            const parsed = JSON.parse(selectedCategories);
            selectedCategories = Array.isArray(parsed) ? parsed : selectedCategories.split(',');
        } catch (_) {
            selectedCategories = selectedCategories.split(',');
        }
    }
    const selectedCategorySet = new Set((Array.isArray(selectedCategories) ? selectedCategories : [selectedCategories]).filter(Boolean).map(String));
    document.querySelectorAll('#prodCategoryCheckboxes input[name="categories"]').forEach(cb => {
        cb.checked = selectedCategorySet.has(cb.value);
    });
    // Set status
    const stSel = document.getElementById('prodStatus');
    if (stSel) stSel.value = status || 'active';
    const channelInput = document.getElementById('prodChannelUrl');
    if (channelInput) channelInput.value = channelUrl || '';
    const downloadInput = document.getElementById('prodDownloadUrl');
    if (downloadInput) downloadInput.value = downloadUrl || '';
    const fakeSoldInput = document.getElementById('prodFakeSold');
    if (fakeSoldInput) fakeSoldInput.value = fakeSold ?? '';
    const strikeInput = document.getElementById('prodStrikePrice');
    if (strikeInput) strikeInput.value = strikePrice ?? '';
    // Pricing
    document.getElementById('pricingRows').innerHTML = '';
    pricingRowCount = 0;
    if (pricing && pricing.length) { pricing.forEach(o => addPricingRow(o.days, o.price, o.reseller_price || '', o.unit || 'd', o.strike_price || '')); }
    else addPricingRow('7','60000');
    openModal('modal-product');
}

