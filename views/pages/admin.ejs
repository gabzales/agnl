        // Juga set mode ke statis dan save — supaya apiGateway (PakKasir/GensPay)
        // yang sudah dipilih admin tidak ikut ketiban.
        if (CURRENT_API_GATEWAY === 'genspay') {
            await api('/admin/settings/genspay', { qrisMode: 'static', apiKey: <%- JSON.stringify(settings.genspay?.apiKey || '') %>, baseUrl: <%- JSON.stringify(settings.genspay?.baseUrl || 'https://genspay.my.id/api/v1') %> });
