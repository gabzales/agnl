// ── Import Cepat dari Teks (diminta client 15 Sep 2026) ──
// Contoh input yang harus kebaca:
//   DRIP PROXY
//   1day 10k
//   3 day 25k
//   7 day 45k
//   30day 100k
// Baris pertama yang bukan pola harga dipakai sebagai Nama Produk. Baris
// berpola "<angka> <hari/day/jam/hour/h> <angka><opsional k/rb/ribu>"
// otomatis jadi baris Opsi Harga (durasi + harga, "k"/"rb"/"ribu" = x1000).
// Dipakai bareng oleh import 1-produk (quick) dan import banyak-produk sekaligus (bulk).
const BULK_PRICE_RE = /^(\d+)\s*(hari|day|jam|hour|h)s?\.?\s+(\d+(?:[.,]\d+)?)\s*(k|rb|ribu)?$/i;
function parseProductTextBlock(lines) {
    let name = '';
    const rows = [];
    for (const line of lines) {
        const m = line.match(BULK_PRICE_RE);
        if (m) {
            const days = parseInt(m[1], 10);
            const unitWord = m[2].toLowerCase();
            const unit = (unitWord === 'jam' || unitWord === 'hour' || unitWord === 'h') ? 'h' : 'd';
            let price = parseFloat(m[3].replace(',', '.'));
            if (m[4]) price = price * 1000;
            rows.push({ days, unit, price: Math.round(price) });
        } else if (!name) {
            name = line;
        }
    }
    return { name, rows };
}

function parseQuickImport() {
    const raw = document.getElementById('quickImportText').value;
    if (!raw.trim()) { toast('Tempel teks produknya dulu di kotak import', 'error'); return; }
    const lines = raw.split(/\r\n|\r|\n/).map(l => l.trim()).filter(l => l);
    const { name, rows: parsedRows } = parseProductTextBlock(lines);
    if (!name && parsedRows.length === 0) {
        toast('Teks tidak dikenali. Pastikan formatnya "1day 10k" per baris', 'error');
        return;
    }
    if (name) document.getElementById('prodName').value = name;
    if (parsedRows.length > 0) {
        document.getElementById('pricingRows').querySelectorAll('[data-pricing-row]').forEach(r => r.remove());
        pricingRowCount = 0;
        parsedRows.forEach(r => addPricingRow(r.days, r.price, '', r.unit, ''));
    }
    toast(`Terisi: ${name ? '1 nama produk' : 'nama produk (tidak terdeteksi)'}, ${parsedRows.length} opsi harga`, 'success');
}

// ── Drag & drop + paste gambar ke field upload produk (diminta client 15 Sep 2026) ──
(function setupProductImageDropzone(){
    const zone = document.getElementById('prodImageDropzone');
    const fileInput = document.getElementById('prodImageFile');
    const preview = document.getElementById('prodImagePreview');
    if (!zone || !fileInput || !preview) return;
    let previewUrl = null;

    function showPreview(file) {
        if (!file || !file.type || !file.type.startsWith('image/')) return;
        if (previewUrl) URL.revokeObjectURL(previewUrl);
        previewUrl = URL.createObjectURL(file);
        preview.src = previewUrl;
        preview.classList.remove('hidden');
    }
    function setFile(file) {
        if (!file || !file.type || !file.type.startsWith('image/')) {
            toast('File gambar tidak valid', 'error');
            return;
        }
        try {
            const dt = new DataTransfer();
            dt.items.add(file);
            fileInput.files = dt.files;
            showPreview(file);
        } catch (err) {
            console.error('[product image] gagal set file:', err);
            toast('Browser tidak mendukung upload drag & drop ini', 'error');
        }
    }

    fileInput.addEventListener('change', () => { if (fileInput.files[0]) showPreview(fileInput.files[0]); });

    ['dragenter','dragover'].forEach(evt => zone.addEventListener(evt, (e) => {
        e.preventDefault(); e.stopPropagation();
        zone.style.borderColor = '#dc2626';
    }));
    ['dragleave','drop'].forEach(evt => zone.addEventListener(evt, (e) => {
        e.preventDefault(); e.stopPropagation();
        zone.style.borderColor = '';
    }));
    zone.addEventListener('drop', (e) => {
        const file = e.dataTransfer.files[0];
        if (file) setFile(file);
    });

    // Paste gambar dari clipboard (mis. copy dari WA Web / browser lain) langsung ke form ini
    document.addEventListener('paste', (e) => {
        const modal = document.getElementById('modal-product');
        if (!modal || !modal.classList.contains('open')) return; // cuma aktif kalau modal tambah/edit produk lagi kebuka
        const items = e.clipboardData && e.clipboardData.items;
        if (!items) return;
        for (const item of items) {
            if (item.type.startsWith('image/')) {
                const file = item.getAsFile();
                if (file) { setFile(file); toast('Gambar dari clipboard berhasil ditempel', 'success'); }
                break;
            }
        }
    });
})();

// ── Import Massal Produk dari 1 File (diminta client 15 Sep 2026) ──
// Beda dari parseQuickImport (1 produk ke form): ini banyak produk sekaligus
// dari 1 file/teks, tiap produk dipisah 1 baris kosong, lalu di-preview dulu
// sebelum benar-benar dibuat (bikin banyak produk sekaligus itu destruktif
// kalau salah parse, makanya wajib direview manual dulu satu-satu).
let bulkParsedProducts = [];

async function getBulkImportRawText() {
    const fileInput = document.getElementById('bulkImportFile');
    if (fileInput.files && fileInput.files[0]) {
        return await fileInput.files[0].text();
    }
    return document.getElementById('bulkImportText').value;
}

function previewBulkImport() {
    getBulkImportRawText().then(raw => {
        if (!raw || !raw.trim()) { toast('Pilih file atau tempel teksnya dulu', 'error'); return; }
        // blok dipisah baris kosong (boleh lebih dari 1 baris kosong berturut-turut)
        const blocks = raw.split(/\r?\n\s*\r?\n/).map(b => b.trim()).filter(b => b);
        bulkParsedProducts = blocks.map(block => {
            const lines = block.split(/\r\n|\r|\n/).map(l => l.trim()).filter(l => l);
            const { name, rows } = parseProductTextBlock(lines);
            const valid = !!name && rows.length > 0;
            return { name: name || '(nama tidak terdeteksi)', rows, valid, include: valid };
        });

        const validCount = bulkParsedProducts.filter(p => p.valid).length;
        document.getElementById('bulkImportSummary').textContent =
            `Terdeteksi ${bulkParsedProducts.length} blok produk — ${validCount} valid, ${bulkParsedProducts.length - validCount} gagal dibaca.`;

        const listEl = document.getElementById('bulkImportList');
        listEl.innerHTML = bulkParsedProducts.map((p, i) => `
            <label class="flex items-start gap-2 p-2 rounded-lg border text-xs cursor-pointer"
                style="border-color:${p.valid ? 'rgba(34,197,94,.25)' : 'rgba(239,68,68,.25)'};background:${p.valid ? 'rgba(34,197,94,.06)' : 'rgba(239,68,68,.06)'};">
                <input type="checkbox" ${p.include ? 'checked' : ''} ${p.valid ? '' : 'disabled'}
                    onchange="bulkParsedProducts[${i}].include=this.checked" class="mt-0.5 accent-red-500">
                <div class="flex-1">
                    <div class="font-bold ${p.valid ? 'text-white' : 'text-red-400'}">${p.name}</div>
                    ${p.valid
                        ? `<div class="text-[10px] text-zinc-500 mt-0.5">${p.rows.map(r => `${r.days}${r.unit==='h'?'jam':'hari'}: Rp${r.price.toLocaleString('id-ID')}`).join(' · ')}</div>`
                        : `<div class="text-[10px] text-red-400/70 mt-0.5">Gak ketemu nama produk / opsi harga yang valid, dilewati</div>`
                    }
                </div>
            </label>
        `).join('');
        document.getElementById('bulkImportPreview').classList.remove('hidden');
    }).catch(err => toast('Gagal membaca file: ' + err.message, 'error'));
}

async function submitBulkImport() {
    const toCreate = bulkParsedProducts.filter(p => p.valid && p.include);
    if (toCreate.length === 0) { toast('Gak ada produk valid yang dicentang', 'error'); return; }
    const btn = document.getElementById('bulkImportSubmitBtn');
    const label = document.getElementById('bulkImportSubmitLabel');
    btn.disabled = true;
    let ok = 0, fail = 0;
    for (let i = 0; i < toCreate.length; i++) {
        const p = toCreate[i];
        label.textContent = `Membuat ${i + 1}/${toCreate.length}: ${p.name}...`;
        const fd = new FormData();
        fd.append('name', p.name);
        p.rows.forEach(r => {
            fd.append('pricingDays', r.days);
            fd.append('pricingUnits', r.unit);
            fd.append('pricingPrices', r.price);
            fd.append('pricingResellerPrices', '');
            fd.append('pricingStrikePrices', '');
        });
        try {
            const r = await fetch('/admin/product/add', { method: 'POST', body: fd });
            const d = await r.json();
            if (d.success) ok++; else { fail++; console.error('[bulk import] gagal:', p.name, d.message); }
        } catch (err) {
            fail++; console.error('[bulk import] error koneksi:', p.name, err);
        }
    }
    btn.disabled = false;
    label.textContent = 'Buat Semua Produk Valid';
    toast(`Selesai: ${ok} produk berhasil dibuat${fail > 0 ? `, ${fail} gagal` : ''}. Jangan lupa upload gambar tiap produk lewat Edit Produk.`, fail > 0 ? 'warn' : 'success');
    if (ok > 0) setTimeout(() => { window.location.href = '/admin#products'; }, 1200);
}


