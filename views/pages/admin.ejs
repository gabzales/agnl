<!-- MODAL: Tambah / Edit Produk -->
<div id="modal-product" class="modal-wrap">
    <div class="modal-bg" onclick="closeModal('modal-product')"></div>
    <div class="modal-box">
        <div class="modal-handle"></div>
        <div class="p-5">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-sm font-bold text-white flex items-center gap-2" id="modalProductTitle">
                    <iconify-icon icon="mdi:package-variant-plus" class="text-red-400"></iconify-icon> Tambah Produk
                </h3>
                <button onclick="closeModal('modal-product')" class="w-7 h-7 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-zinc-400">
                    <iconify-icon icon="mdi:close"></iconify-icon>
                </button>
            </div>
            <form id="addProductForm" class="space-y-3" enctype="multipart/form-data">
                <input type="hidden" name="_productId" id="editProductId">

                <!-- IMPORT CEPAT DARI TEKS (diminta client 15 Sep 2026, referensi -->
                <!-- forward chat WA jualan "1day 10k / 3 day 25k / 7 day 45k") -->
                <div class="rounded-xl p-3" style="background:var(--neon-purple-10);border:1px solid var(--neon-purple-20)">
                    <div class="text-[11px] font-bold text-red-300 mb-1.5 flex items-center gap-1.5">
                        <iconify-icon icon="mdi:auto-fix"></iconify-icon> Import Cepat dari Teks (opsional)
                    </div>
                    <textarea id="quickImportText" rows="4" class="hm-input text-xs" placeholder="Tempel di sini, contoh:&#10;DRIP PROXY&#10;1day 10k&#10;3 day 25k&#10;7 day 45k&#10;30day 100k"></textarea>
                    <div class="flex items-center justify-between mt-1.5">
                        <p class="text-[10px]" style="color:var(--text-3);">Baris pertama = nama produk, baris "angka + hari/jam + angka+k" otomatis jadi opsi harga. Gambar tetap upload manual di bawah (drag/drop atau paste gambar juga bisa).</p>
                        <button type="button" onclick="parseQuickImport()" class="shrink-0 ml-2 px-3 py-1.5 rounded-lg text-[11px] font-bold text-white" style="background:#dc2626;">Isi Otomatis</button>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <div class="setting-row-label">Nama Produk *</div>
                        <input type="text" name="name" id="prodName" required class="hm-input" placeholder="Drip Client">
                    </div>
                </div>
                <div>
                    <!-- FIX (diminta client 22 Agu 2026): kategori sekarang MULTI-SELECT
                         (produk bisa masuk lebih dari 1 kategori sekaligus, mis. "Free Fire"
                         DAN "Android" bersamaan), dan daftar kategorinya sepenuhnya diatur
                         admin lewat menu Kategori -- bukan hardcode Android/iOS/PC lagi. -->
                    <div class="setting-row-label">Kategori <span class="text-zinc-600 font-normal">(bisa pilih lebih dari satu)</span></div>
                    <div class="flex flex-wrap gap-2" id="prodCategoryCheckboxes">
                        <% (settings.categories||[]).forEach(cat => { %>
                        <label class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-white/10 bg-white/3 cursor-pointer text-xs">
                            <input type="checkbox" name="categories" value="<%= cat %>" class="accent-red-500">
                            <%= (settings.categoryLabels||{})[cat]||cat %>
                        </label>
                        <% }) %>
                        <% if (!(settings.categories||[]).length) { %>
                        <span class="text-[11px] text-zinc-600">Belum ada kategori. Tambah dulu di menu Kategori.</span>
                        <% } %>
                    </div>
                </div>
                <div>
                    <div class="setting-row-label">Deskripsi</div>
                    <textarea name="description" id="prodDesc" rows="5" class="hm-input" placeholder="Deskripsi singkat produk...&#10;&#10;- Fitur cheat pertama&#10;- Fitur cheat kedua&#10;- Fitur cheat ketiga"></textarea>
                    <div class="text-[10px] mt-1" style="color:var(--text-3);">Baris biasa jadi paragraf. Baris yang diawali <code class="text-red-400">-</code> otomatis jadi daftar fitur bercentang di halaman produk (referensi fixaonly.com).</div>
                </div>
                <div>
                    <div class="setting-row-label">Gambar (URL atau upload)</div>
                    <input type="text" name="imageUrl" id="prodImageUrl" class="hm-input mb-2" placeholder="https://cdn.../gambar.png">
                    <div id="prodImageDropzone" class="rounded-lg border border-dashed border-white/15 p-3 text-center transition-colors" style="cursor:pointer;">
                        <input type="file" name="image" id="prodImageFile" accept="image/*" class="hm-input text-xs py-2">
                        <p class="text-[10px] mt-1.5" style="color:var(--text-3);">Bisa juga drag & drop gambar ke sini, atau paste (Ctrl+V) gambar yang di-copy dari mana saja.</p>
                        <img id="prodImagePreview" class="hidden mt-2 mx-auto rounded-lg" style="max-height:120px;object-fit:contain;">
                    </div>
                </div>
                <div>
                    <div class="setting-row-label">Link Channel / Grup Produk</div>
                    <input type="url" name="channelUrl" id="prodChannelUrl" class="hm-input" placeholder="https://whatsapp.com/channel/...">
                    <div class="text-[10px] mt-1" style="color:var(--text-3);">Muncul sebagai tombol "Download / Join Channel" di halaman invoice setelah buyer dapat key. Kosongkan jika tidak perlu.</div>
                </div>
                <div>
                    <div class="setting-row-label">Link Download Langsung (opsional)</div>
                    <input type="url" name="downloadUrl" id="prodDownloadUrl" class="hm-input" placeholder="https://drive.google.com/... atau link APK/file">
                    <div class="text-[10px] mt-1" style="color:var(--text-3);">Kalau diisi, tombol di KARTU PRODUK (halaman utama) berubah jadi "Download" yang langsung buka link ini, tidak lewat alur beli/checkout. Kosongkan kalau produk ini tetap dijual normal lewat Beli.</div>
                </div>

                <!-- PRICING TABLE (like deem) -->
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <div class="setting-row-label mb-0">Opsi Harga *</div>
                        <button type="button" onclick="addPricingRow()" class="flex items-center gap-1 text-[11px] text-red-400 hover:text-red-300 transition-colors">
                            <iconify-icon icon="mdi:plus-circle"></iconify-icon> Tambah Durasi
                        </button>
                    </div>
                    <div id="pricingRows" class="space-y-2">
                        <div class="flex items-center gap-2 text-[9px] font-bold uppercase tracking-wider text-zinc-600 px-0.5">
                            <div style="flex:0 0 56px">Jml</div>
                            <div style="flex:0 0 64px">Unit</div>
                            <div style="flex:1 1 100px">Harga Normal</div>
                            <div style="flex:1 1 100px">Harga Reseller <span class="normal-case font-normal text-zinc-700">(kosong = %)</span></div>
                            <div style="flex:1 1 100px">Harga Coret <span class="normal-case font-normal text-zinc-700">(opsional)</span></div>
                            <div style="width:32px"></div>
                        </div>
                        <!-- rows injected by JS -->
                    </div>
                    <p class="text-[10px] text-zinc-600 mt-1">Key format: <code class="text-red-400">KEY123</code> (generic), <code class="text-red-400">KEY123=7d</code> (7 hari), atau <code class="text-red-400">KEY123=12h</code> (12 jam)</p>
                </div>

                <!-- ANGKA TERJUAL & HARGA CORET (manual, opsional) -->
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <div class="setting-row-label">Angka "Terjual" Manual <span class="text-zinc-600 font-normal">(opsional)</span></div>
                        <input type="number" name="fakeSold" id="prodFakeSold" min="0" class="hm-input" placeholder="Kosongkan = otomatis">
                        <div class="text-[10px] mt-1" style="color:var(--text-3);">Override tampilan "Terjual X" di katalog. Kosongkan untuk pakai angka penjualan asli.</div>
                    </div>
                    <div>
                        <div class="setting-row-label">Harga Coret <span class="text-zinc-600 font-normal">(opsional)</span></div>
                        <input type="number" name="strikePrice" id="prodStrikePrice" min="0" class="hm-input" placeholder="Kosongkan = tidak ada">
                        <div class="text-[10px] mt-1" style="color:var(--text-3);">Harga "asli" yang dicoret di sebelah harga jual, kesan diskon. Tidak memengaruhi harga tagihan.</div>
                    </div>
                </div>

                <!-- STATUS -->
                <div>
                    <div class="setting-row-label">Status</div>
                    <select name="status" id="prodStatus" class="hm-input">
                        <option value="active">Aktif</option>
                        <option value="inactive">Nonaktif</option>
                    </select>
                </div>

                <!-- KEYS TEXTAREA -->
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <div class="setting-row-label mb-0">Keys / Lisensi</div>
                        <span id="prodKeyCount" class="text-[10px] text-zinc-500"></span>
                    </div>
                    <textarea name="keys" id="prodKeys" rows="5" class="hm-input font-mono text-xs"
                        placeholder="KEY-FF-001&#10;KEY-FF-002:7&#10;KEY-FF-003:30&#10;&#10;Kosongkan = tidak ubah keys (mode edit)"></textarea>
                    <div class="flex gap-2 mt-1" id="keysModeRow">
                        <label class="flex items-center gap-1 text-[11px] text-zinc-400 cursor-pointer">
                            <input type="radio" name="keysMode" value="append" checked class="accent-zinc-500"> Tambah ke stok existing
                        </label>
                        <label class="flex items-center gap-1 text-[11px] text-zinc-400 cursor-pointer">
                            <input type="radio" name="keysMode" value="replace" class="accent-red-500"> Ganti semua keys
                        </label>
                    </div>
                </div>

                <div class="flex gap-2 pt-1">
                    <button type="submit" id="prodSubmitBtn" class="btn-primary flex-1 justify-center py-2.5 text-xs">
                        <iconify-icon icon="mdi:plus"></iconify-icon> <span id="prodSubmitLabel">Tambah Produk</span>
                    </button>
                    <button type="button" onclick="closeModal('modal-product')" class="btn-danger justify-center py-2.5 px-4 text-xs">Batal</button>
                </div>
            </form>
        </div>
    </div>
</div>

