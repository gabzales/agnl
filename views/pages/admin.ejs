                </button>
                <button onclick="deleteBanner('${b.id}')"
                    class="px-2 py-1 rounded text-[10px] font-bold border border-red-500/30 text-red-400 bg-red-500/10 hover:bg-red-500/20 transition-all">
                    Hapus
                </button>
            </div>
        </div>`).join('');
}

async function addBanner(e) {
    e.preventDefault();
    const btn = document.getElementById('bannerAddBtn');
    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<iconify-icon icon="mdi:loading" class="animate-spin"></iconify-icon> Menyimpan...';
    }
    try {
        const fd = new FormData(e.target);
        const res = await fetch('/admin/banners/add', { method: 'POST', body: fd, headers: { 'Accept': 'application/json' } });
        const ct = res.headers.get('content-type') || '';
        const d = ct.includes('application/json') ? await res.json() : { success:false, message:`Gagal tambah banner (${res.status})` };
        if (!res.ok || !d.success) {
            toast(d.message || 'Gagal tambah banner', 'error');
            return;
        }
        toast('Banner berhasil ditambahkan!', 'success');
        window._allBanners = Array.isArray(d.banners) ? d.banners : [...(window._allBanners || [])];
        renderBanners(window._allBanners);
        e.target.reset();
        document.getElementById('bannerFilePreview')?.classList.add('hidden');
        document.getElementById('bannerUrlPreview')?.classList.add('hidden');
    } catch (err) {
        toast(`Gagal tambah banner: ${err.message}`, 'error');
        console.error('[banner add]', err);
    } finally {
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<iconify-icon icon="mdi:plus-circle"></iconify-icon> Tambah Banner';
        }
    }
}

async function toggleBanner(id) {
    try {
    const d = await api(`/admin/banners/toggle/${id}`, {});
    if (d.success) {
        window._allBanners = window._allBanners.map(b => b.id===id ? {...b, active:d.active} : b);
        renderBanners(window._allBanners);
        toast(`Banner ${d.active?'diaktifkan':'dinonaktifkan'}`, 'success');
    } else toast(d.message || 'Gagal mengubah status banner', 'error');
    } catch (err) { toast(`Gagal mengubah banner: ${err.message}`, 'error'); }
}

async function deleteBanner(id) {
    if (!confirm('Hapus banner ini?')) return;
    try {
    const d = await api(`/admin/banners/delete/${id}`, {});
    if (d.success) {
        window._allBanners = window._allBanners.filter(b => b.id!==id);
        renderBanners(window._allBanners);
        toast('Banner dihapus', 'success');
    } else toast(d.message || 'Gagal menghapus banner', 'error');
    } catch (err) { toast(`Gagal menghapus banner: ${err.message}`, 'error'); }
}

// Banner data is rendered server-side so the admin can see inactive banners too.
window._allBanners = <%- safeJson(settings.banners || []) %>;

// FIX (24 Agu 2026, diminta client): tombol "Tambah Cepat" untuk isi 3
// kategori platform standar (android/ios/pc) sekali klik, tanpa perlu
// admin ngetik manual format id:Label. Menambahkan ke baris yang SUDAH
// ADA di textarea (tidak menimpa kategori custom lain seperti nama game
// yang mungkin sudah diisi admin sebelumnya), dan melewati platform yang
// sudah ada supaya tidak duplikat kalau diklik berkali-kali.
function quickAddPlatformCategories() {
    const textarea = document.getElementById('categoryTextarea');
    const existingLines = textarea.value.split('\n').map(l => l.trim()).filter(Boolean);
    const existingIds = existingLines.map(l => l.split(':')[0].trim().toLowerCase());
    const platforms = [['android', 'ANDROID'], ['ios', 'IOS'], ['pc', 'PC']];
    const toAdd = platforms.filter(([id]) => !existingIds.includes(id)).map(([id, label]) => `${id}:${label}`);
    if (toAdd.length === 0) {
        toast('Android, iOS, PC sudah ada di daftar kategori', 'info');
        return;
    }
    textarea.value = existingLines.concat(toAdd).join('\n');
    toast(`Ditambahkan: ${toAdd.map(l => l.split(':')[0]).join(', ')}. Klik "Simpan Kategori" untuk menyimpan.`, 'success');
}

document.getElementById('categoryForm')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const fd = new FormData(this);
    const raw = fd.get('categories') || '';
    const lines = raw.trim().split('\n').filter(l=>l.trim());
    const cats = [], labels = {};
    lines.forEach(line => {
        const [id, ...rest] = line.split(':');
        if (id && id.trim()) { cats.push(id.trim()); labels[id.trim()] = rest.join(':').trim()||id.trim(); }
    });
    if (!cats.length) { toast('Minimal 1 kategori diperlukan', 'error'); return; }
    const d = await api('/admin/settings/update', { categories: JSON.stringify(cats), categoryLabels: JSON.stringify(labels) });
    if (d.success) { toast('Kategori disimpan!', 'success'); setTimeout(()=>window.location.href='/admin#settings',800); }
    else toast(d.message, 'error');
});

// ═══ SALES CHART ═══
(function initSalesChart() {
    const ctx = document.getElementById('salesChart');
    if (!ctx || typeof Chart === 'undefined') return;
    const raw = <%- safeJson(chartData) %>;
    const labels = raw.map(d => d.date);
    const counts = raw.map(d => d.count);
    const revenues = raw.map(d => d.revenue);
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels,
            datasets: [
                {
                    label: 'Transaksi',
                    data: counts,
                    backgroundColor: <%- JSON.stringify(hexToRgba(settings?.theme?.primaryColor || "#dc2626", 0.6)) %>,
                    borderColor: <%- JSON.stringify(settings?.theme?.primaryColor || "#dc2626") %>,
                    borderWidth: 1,
                    borderRadius: 6,
                    yAxisID: 'y'
                },
                {
                    label: 'Revenue (K)',
                    data: revenues.map(r => Math.round(r/1000)),
                    type: 'line',
                    borderColor: 'rgba(52,211,153,.8)',
                    backgroundColor: 'rgba(52,211,153,.1)',
                    pointBackgroundColor: '#34d399',
                    pointRadius: 4,
                    tension: 0.4,
                    fill: true,
                    yAxisID: 'y2'
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: { mode: 'index', intersect: false },
            plugins: {
                legend: { labels: { color: '#a1a1aa', font: { size: 10 } } },
                tooltip: { backgroundColor: 'rgba(15,15,37,.95)', titleColor:'#fff', bodyColor:'#a1a1aa', borderColor:<%- JSON.stringify(hexToRgba(settings?.theme?.primaryColor || "#dc2626", 0.25)) %>, borderWidth:1 }
            },
            scales: {
                x: { ticks: { color: '#52525b', font: { size: 9 } }, grid: { color: '#f4f4f5' } },
                y: { ticks: { color: <%- JSON.stringify(settings?.theme?.accentColor || "#f87171") %>, font: { size: 9 } }, grid: { color: <%- JSON.stringify(hexToRgba(settings?.theme?.primaryColor || "#dc2626", 0.1)) %> }, title: { display: true, text: 'Transaksi', color: <%- JSON.stringify(settings?.theme?.accentColor || "#f87171") %>, font: { size: 9 } } },
                y2: { position: 'right', ticks: { color: '#34d399', font: { size: 9 } }, grid: { drawOnChartArea: false }, title: { display: true, text: 'Revenue (K)', color: '#34d399', font: { size: 9 } } }
            }
        }
    });
})();

// ═══ KEY POOL MANAGEMENT ═══
let _allKeys = [];

async function loadKeys() {
    try {
        const r = await fetch('/admin/keyspool', { headers: { 'Accept': 'application/json' } });
        const contentType = r.headers.get('content-type') || '';
        const d = contentType.includes('application/json') ? await r.json() : { success:false, message:`Gagal memuat key (${r.status})` };
        if (!r.ok || !d.success) { toast(d.message || 'Gagal memuat key', 'error'); return; }
        _allKeys = Array.isArray(d.data) ? d.data : [];
        renderKeys(_allKeys);
    } catch (err) {
        toast(`Gagal memuat key: ${err.message}`, 'error');
    }
}

function renderKeys(keys) {
    keys = Array.isArray(keys) ? keys : [];
    const list = document.getElementById('keysList');
    const total = document.getElementById('keyTotal');
    const stats = document.getElementById('keyStatsLabel');
    if (!list) return;
    const used = keys.filter(k => k.used).length;
    const avail = keys.length - used;
    if (total) total.textContent = keys.length;
    if (stats) stats.textContent = `${avail} tersedia · ${used} terpakai`;
    if (!keys.length) {
        list.innerHTML = '<div class="text-center py-8 text-zinc-600 text-xs"><iconify-icon icon="mdi:key-off" class="text-3xl block mx-auto mb-2 text-zinc-700"></iconify-icon>Belum ada key</div>';
        return;
    }
    list.innerHTML = keys.map(k => `
        <div class="neon-card p-3 flex items-center gap-3 ${k.used ? 'opacity-60' : ''}">
            <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 ${k.used ? 'bg-zinc-800' : 'bg-red-500/15 border border-zinc-500/25'}">
                <iconify-icon icon="${k.used ? 'mdi:key-off' : 'mdi:key'}" class="text-base ${k.used ? 'text-zinc-600' : 'text-red-400'}"></iconify-icon>
            </div>
            <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-mono text-sm font-black text-white">${k.code}</span>
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded ${k.used ? 'bg-zinc-700 text-zinc-500' : 'bg-red-500/20 text-red-400 border border-red-500/30'}">
                        ${k.duration} Hari
                    </span>
                    ${k.used ? `<span class="text-[9px] bg-red-500/15 text-red-400 border border-red-500/25 px-1.5 py-0.5 rounded font-bold">TERPAKAI</span>` : '<span class="text-[9px] bg-emerald-500/15 text-emerald-400 border border-emerald-500/25 px-1.5 py-0.5 rounded font-bold">TERSEDIA</span>'}
                </div>
                <div class="text-[10px] text-zinc-500 mt-0.5">
                    ${k.label !== k.duration + ' Hari' ? k.label + ' · ' : ''}
                    ${k.used ? `Digunakan: <span class="text-zinc-400">${k.usedByUsername || '?'}</span>` : `Dibuat: ${new Date(k.createdAt).toLocaleDateString('id-ID')}`}
                </div>
            </div>
            <button onclick="deleteKey('${k.id}')" class="btn-danger py-1 px-2 text-[10px]" ${k.used ? 'disabled style="opacity:.4"' : ''}>
                <iconify-icon icon="mdi:trash-can"></iconify-icon>
            </button>
        </div>`).join('');
}

async function addKey() {
    const code = document.getElementById('newKeyCode').value.trim();
    const duration = document.getElementById('newKeyDuration').value.trim();
    const label = document.getElementById('newKeyLabel').value.trim();
    const note = document.getElementById('newKeyNote').value.trim();
    if (!code || !duration) { toast('Kode dan durasi wajib diisi', 'error'); return; }
    const d = await api('/admin/keyspool/add', { code, duration, label, note });
    if (d.success) {
        toast('Key berhasil ditambahkan!', 'success');
        document.getElementById('newKeyCode').value = '';
        document.getElementById('newKeyDuration').value = '';
        document.getElementById('newKeyLabel').value = '';
        document.getElementById('newKeyNote').value = '';
        _allKeys = d.data;
        renderKeys(_allKeys);
    } else toast(d.message, 'error');
}

async function generateKeys() {
    const count = document.getElementById('genCount').value;
    const duration = document.getElementById('genDuration').value;
    const prefix = document.getElementById('genPrefix').value;
    if (!duration || parseInt(duration) <= 0) { toast('Durasi tidak valid', 'error'); return; }
    const d = await api('/admin/keyspool/generate', { count, duration, prefix });
    if (d.success) {
        toast(`${d.generated} key berhasil dibuat!`, 'success');
        _allKeys = d.data;
        renderKeys(_allKeys);
        const res = document.getElementById('genResult');
        res.classList.remove('hidden');
        res.innerHTML = `<div class="p-3 rounded-xl text-xs font-mono text-red-300 break-all" style="background:var(--neon-purple-10);border:1px solid var(--neon-purple-20)">${d.codes.join('<br>')}</div>`;
    } else toast(d.message, 'error');
}

async function deleteKey(id) {
    if (!confirm('Hapus key ini?')) return;
    const d = await api('/admin/keyspool/delete/' + id, {});
    if (d.success) {
        toast('Key dihapus', 'success');
        _allKeys = _allKeys.filter(k => k.id !== id);
        renderKeys(_allKeys);
    } else toast(d.message, 'error');
}

// ═══ VOUCHER MANAGEMENT ═══
async function loadVouchers() {
    try {
        const r = await fetch('/admin/vouchers', { headers: { 'Accept': 'application/json' } });
        const contentType = r.headers.get('content-type') || '';
        const d = contentType.includes('application/json') ? await r.json() : { success:false, message:`Gagal memuat voucher (${r.status})` };
        if (!r.ok || !d.success) { toast(d.message || 'Gagal memuat voucher', 'error'); return; }
        renderVouchers(Array.isArray(d.data) ? d.data : []);
    } catch (err) {
        toast(`Gagal memuat voucher: ${err.message}`, 'error');
    }
}

function renderVouchers(vouchers) {
    vouchers = Array.isArray(vouchers) ? vouchers : [];
    const list = document.getElementById('vouchersList');
    const stats = document.getElementById('voucherStatsLabel');
    if (!list) return;
    const active = vouchers.filter(v => v.active).length;
    if (stats) stats.textContent = `${vouchers.length} total · ${active} aktif`;
    if (!vouchers.length) {
        list.innerHTML = '<div class="text-center py-8 text-zinc-600 text-xs"><iconify-icon icon="mdi:ticket-outline" class="text-3xl block mx-auto mb-2 text-zinc-700"></iconify-icon>Belum ada voucher</div>';
        return;
    }
    list.innerHTML = vouchers.map(v => {
        const expired = v.expiresAt && new Date(v.expiresAt) < new Date();
        const exhausted = v.maxUses > 0 && v.usedCount >= v.maxUses;
        const isInactive = !v.active || expired || exhausted;
        const valDisplay = v.type === 'percent' ? v.value + '%' : 'Rp ' + v.value.toLocaleString('id-ID');
        const minDisplay = v.minPurchase > 0 ? 'Min Rp ' + v.minPurchase.toLocaleString('id-ID') : 'Tanpa min';
        return `<div class="neon-card p-3 flex items-center gap-3 ${isInactive ? 'opacity-50' : ''}">
            <div class="w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0 ${v.active ? 'bg-green-500/15 border border-green-500/25' : 'bg-zinc-800'}">
                <iconify-icon icon="${v.active ? 'mdi:ticket-percent' : 'mdi:ticket-off'}" class="text-lg ${v.active ? 'text-green-400' : 'text-zinc-600'}"></iconify-icon>
            </div>
            <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-mono text-sm font-black text-white">${v.code}</span>
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded ${v.active ? 'bg-green-500/20 text-green-400 border border-green-500/30' : 'bg-zinc-700 text-zinc-500'}">${valDisplay}</span>
                    ${v.excludeReseller ? '<span class="text-[9px] font-bold px-1.5 py-0.5 rounded" style="background:rgba(234,179,8,.12);color:#fbbf24;border:1px solid rgba(234,179,8,.25)">Non-Reseller</span>' : ''}
                </div>
                <div class="flex items-center gap-3 text-[10px] mt-0.5 flex-wrap">
                    <span class="text-zinc-500">${v.description || '—'}</span>
                    <span class="text-zinc-600">${minDisplay}</span>
                    <span class="text-zinc-600">${v.usedCount}/${v.maxUses || '∞'} dipakai</span>
                </div>
                ${v.expiresAt ? `<div class="text-[9px] ${expired ? 'text-red-400' : 'text-zinc-500'}">Kadaluarsa: ${new Date(v.expiresAt).toLocaleDateString('id-ID')}</div>` : ''}
            </div>
            <div class="flex flex-col gap-1">
                <button onclick="toggleVoucher('${v.id}')" class="px-2 py-1 text-[10px] rounded-lg border transition-all font-semibold ${v.active ? 'bg-yellow-500/15 border-yellow-500/30 text-yellow-400 hover:bg-yellow-500/25' : 'bg-emerald-500/15 border-emerald-500/30 text-emerald-400 hover:bg-emerald-500/25'}">
                    <iconify-icon icon="${v.active ? 'mdi:pause' : 'mdi:play'}"></iconify-icon>
                    ${v.active ? 'Nonaktif' : 'Aktifkan'}
                </button>
                <button onclick="deleteVoucher('${v.id}')" class="btn-danger py-1 px-2 text-[10px]">
                    <iconify-icon icon="mdi:trash-can"></iconify-icon>
                </button>
            </div>
        </div>`;
    }).join('');
}

async function addVoucher() {
    const code = document.getElementById('newVoucherCode').value.trim();
    const type = document.getElementById('newVoucherType').value;
    const value = document.getElementById('newVoucherValue').value;
    const minPurchase = document.getElementById('newVoucherMin').value;
    const maxUses = document.getElementById('newVoucherMax').value;
    const perUserLimit = document.getElementById('newVoucherPerUser').value;
    const expiresAt = document.getElementById('newVoucherExpiry').value;
    const description = document.getElementById('newVoucherDesc').value.trim();
    if (!code || !value) { toast('Kode dan nilai wajib diisi', 'error'); return; }
    const d = await api('/admin/vouchers/add', { code, type, value, minPurchase, maxUses, perUserLimit, expiresAt, description, excludeReseller: document.getElementById('newVoucherExcludeReseller').checked });
    if (d.success) {
        toast('Voucher berhasil dibuat!', 'success');
        document.getElementById('newVoucherCode').value = '';
        document.getElementById('newVoucherValue').value = '';
        document.getElementById('newVoucherDesc').value = '';
        renderVouchers(d.data);
    } else toast(d.message, 'error');
}

async function toggleVoucher(id) {
    const d = await api('/admin/vouchers/toggle/' + id, {});
    if (d.success) loadVouchers();
    else toast(d.message, 'error');
}

async function deleteVoucher(id) {
    if (!confirm('Hapus voucher ini?')) return;
    const d = await api('/admin/vouchers/delete/' + id, {});
    if (d.success) {
        toast('Voucher dihapus', 'success');
        loadVouchers();
    } else toast(d.message, 'error');
}

// ═══ EXPORT / IMPORT DATABASE ═══
async function importDB(event) {
    const file = event.target.files[0];
    const statusEl = document.getElementById('importStatus');
    if (!file) return;
    statusEl.classList.remove('hidden');
    statusEl.innerHTML = '<div class="flex items-center gap-2 text-xs text-red-400"><iconify-icon icon="mdi:loading" class="animate-spin"></iconify-icon> Membaca file...</div>';
    try {
        const text = await file.text();
        const data = JSON.parse(text);
        const r = await fetch('/admin/import', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const d = await r.json();
        if (d.success) {
            statusEl.innerHTML = `<div class="flex items-center gap-2 text-xs text-emerald-400"><iconify-icon icon="mdi:check-circle"></iconify-icon> ${d.message}. Reload...</div>`;
            setTimeout(() => location.reload(), 1000);
        } else {
            statusEl.innerHTML = `<div class="flex items-center gap-2 text-xs text-red-400"><iconify-icon icon="mdi:alert-circle"></iconify-icon> ${d.message}</div>`;
        }
    } catch(e) {
        statusEl.innerHTML = `<div class="flex items-center gap-2 text-xs text-red-400"><iconify-icon icon="mdi:alert-circle"></iconify-icon> File tidak valid: ${e.message}</div>`;
    }
    event.target.value = '';
}
</script>
