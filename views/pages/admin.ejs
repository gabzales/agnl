<!-- ── KEY POOL ── -->
<div id="pane-keys" class="tab-pane">
    <div class="flex items-center justify-between mb-4">
        <div class="section-label mb-0">Manajemen Key Lisensi</div>
        <span class="text-[10px] text-zinc-600" id="keyStatsLabel">—</span>
    </div>

    <!-- Form tambah / generate key -->
    <div class="neon-card p-4 mb-4">
        <div class="text-xs font-bold text-red-400 mb-3 flex items-center gap-2">
            <iconify-icon icon="mdi:key-plus" class="text-base"></iconify-icon> Tambah Key Manual
        </div>
        <div class="grid grid-cols-2 gap-2 mb-2">
            <div>
                <div class="setting-row-label">Kode Key</div>
                <input type="text" id="newKeyCode" class="hm-input font-mono uppercase" placeholder="HERO-001" maxlength="20" oninput="this.value=this.value.toUpperCase()">
            </div>
            <div>
                <div class="setting-row-label">Durasi (Hari)</div>
                <input type="number" id="newKeyDuration" class="hm-input" placeholder="30" min="1" max="9999">
            </div>
        </div>
        <div class="mb-2">
            <div class="setting-row-label">Label (opsional)</div>
            <input type="text" id="newKeyLabel" class="hm-input" placeholder="30 Hari Akses Premium">
        </div>
        <div class="mb-3">
            <div class="setting-row-label">Catatan (opsional)</div>
            <input type="text" id="newKeyNote" class="hm-input" placeholder="Untuk pelanggan paket...">
        </div>
        <button onclick="addKey()" class="btn-primary w-full">
            <iconify-icon icon="mdi:plus-circle"></iconify-icon> Tambah Key
        </button>
    </div>

    <!-- Generate otomatis -->
    <div class="neon-card p-4 mb-4">
        <div class="text-xs font-bold text-red-400 mb-3 flex items-center gap-2">
            <iconify-icon icon="mdi:auto-fix" class="text-base"></iconify-icon> Generate Key Otomatis
        </div>
        <div class="grid grid-cols-3 gap-2 mb-2">
            <div>
                <div class="setting-row-label">Jumlah</div>
                <input type="number" id="genCount" class="hm-input" placeholder="5" min="1" max="100" value="5">
            </div>
            <div>
                <div class="setting-row-label">Durasi (Hari)</div>
                <input type="number" id="genDuration" class="hm-input" placeholder="30" min="1" value="30">
            </div>
            <div>
                <div class="setting-row-label">Prefix</div>
                <input type="text" id="genPrefix" class="hm-input uppercase" placeholder="KEY" maxlength="8" value="KEY" oninput="this.value=this.value.toUpperCase()">
            </div>
        </div>
        <button onclick="generateKeys()" class="btn-primary w-full" style="background:var(--neon-purple)">
            <iconify-icon icon="mdi:lightning-bolt"></iconify-icon> Generate Keys
        </button>
        <div id="genResult" class="mt-2 hidden"></div>
    </div>

    <!-- Daftar key -->
    <div class="section-label">Daftar Key (<span id="keyTotal">0</span>)</div>
    <div class="space-y-2" id="keysList">
        <div class="text-center py-6 text-zinc-600 text-xs">
            <iconify-icon icon="mdi:loading" class="text-xl text-red-400 animate-spin block mx-auto mb-2"></iconify-icon>
            Memuat...
        </div>
    </div>
</div>

<!-- ── VOUCHERS ── -->
<div id="pane-vouchers" class="tab-pane">
    <div class="flex items-center justify-between mb-4">
        <div class="section-label mb-0">Manajemen Voucher Diskon</div>
        <span class="text-[10px] text-zinc-600" id="voucherStatsLabel">—</span>
    </div>

    <!-- Form tambah voucher -->
    <div class="neon-card p-4 mb-4">
        <div class="text-xs font-bold text-green-400 mb-3 flex items-center gap-2">
            <iconify-icon icon="mdi:ticket-percent" class="text-base"></iconify-icon> Tambah Voucher
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-2">
            <div>
                <div class="setting-row-label">Kode Voucher</div>
                <input type="text" id="newVoucherCode" class="hm-input font-mono uppercase" placeholder="DISC30" maxlength="20" oninput="this.value=this.value.toUpperCase()">
            </div>
            <div>
                <div class="setting-row-label">Tipe</div>
                <select id="newVoucherType" class="hm-input">
                    <option value="percent">Persen (%)</option>
                    <option value="nominal">Nominal (Rp)</option>
                </select>
            </div>
            <div>
                <div class="setting-row-label">Nilai</div>
                <input type="number" id="newVoucherValue" class="hm-input" placeholder="10 / 5000" min="1">
            </div>
            <div>
                <div class="setting-row-label">Min. Belanja</div>
                <input type="number" id="newVoucherMin" class="hm-input" placeholder="0 (tanpa min)" min="0" value="0">
            </div>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 mb-2">
            <div>
                <div class="setting-row-label">Maks. Pemakaian</div>
                <input type="number" id="newVoucherMax" class="hm-input" placeholder="0 = tak terbatas" min="0" value="0">
            </div>
            <div>
                <div class="setting-row-label">Per User</div>
                <input type="number" id="newVoucherPerUser" class="hm-input" placeholder="1" min="1" value="1">
            </div>
            <div>
                <div class="setting-row-label">Kadaluarsa</div>
                <input type="date" id="newVoucherExpiry" class="hm-input">
            </div>
        </div>
        <div class="mb-3">
            <div class="setting-row-label">Deskripsi (opsional)</div>
            <input type="text" id="newVoucherDesc" class="hm-input" placeholder="Diskon 30% untuk semua produk">
        </div>
        <div class="mb-3 flex items-center gap-3 p-3 rounded-xl" style="background:rgba(234,179,8,.06);border:1px solid rgba(234,179,8,.18);">
            <input type="checkbox" id="newVoucherExcludeReseller" class="w-4 h-4 rounded accent-yellow-400">
            <div>
                <div class="text-[11px] font-semibold text-yellow-300">Tidak berlaku untuk Reseller</div>
                <div class="text-[10px] text-zinc-500">Cegah double-discount: reseller tidak bisa pakai voucher ini karena sudah dapat harga reseller</div>
            </div>
        </div>
        <button onclick="addVoucher()" class="btn-primary w-full" style="background:#059669">
            <iconify-icon icon="mdi:plus-circle"></iconify-icon> Buat Voucher
        </button>
    </div>

    <!-- Daftar voucher -->
    <div class="space-y-2" id="vouchersList">
        <div class="text-center py-6 text-zinc-600 text-xs">
            <iconify-icon icon="mdi:loading" class="text-xl text-red-400 animate-spin block mx-auto mb-2"></iconify-icon>
            Memuat...
        </div>
    </div>
</div>

<!-- ── SETTINGS ── -->
<div id="pane-settings" class="tab-pane">
    <div class="section-label mb-3">Pengaturan Situs</div>

    <!-- Status Database Supabase -->
    <div id="dbStatusCard" class="neon-card p-4 mb-3">
        <div class="text-xs font-bold text-emerald-400 mb-3 flex items-center gap-2">
            <iconify-icon icon="mdi:database"></iconify-icon> Status Database (Supabase)
        </div>
        <div id="dbStatusContent" class="text-xs text-zinc-400">Memeriksa koneksi...</div>
    </div>

    <!-- Info Situs -->
    <div class="neon-card p-5 mb-3">
        <div class="text-xs font-bold text-red-400 mb-4 flex items-center gap-2">
            <iconify-icon icon="mdi:information-outline"></iconify-icon> Informasi Situs
        </div>
        <form id="settingsForm" class="space-y-3">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <div class="setting-row-label">Nama Situs</div>
                    <input type="text" name="siteName" value="<%= settings.siteName %>" class="hm-input">
                </div>
                <div>
                    <div class="setting-row-label">Nama Game Panel</div>
                    <input type="text" name="gamePanelName" value="<%= settings.gamePanelName %>" class="hm-input">
                </div>
            </div>
            <div>
                <div class="setting-row-label">Deskripsi / About</div>
                <textarea name="about" rows="3" class="hm-input"><%= settings.about %></textarea>
            </div>
            <div>
                <div class="setting-row-label">Domain Situs (untuk SEO) <span class="text-zinc-600 font-normal">(opsional, kosongkan = deteksi otomatis)</span></div>
                <input type="text" name="siteUrl" value="<%= settings.siteUrl||'' %>" class="hm-input" placeholder="https://agha.nlstoreshop.my.id">
                <div class="text-[10px] mt-1" style="color:var(--text-3);">Dipakai untuk canonical URL, Open Graph, dan sitemap.xml. Isi kalau sudah pakai domain custom.</div>
            </div>
            <div>
                <div class="setting-row-label">Kata Kunci SEO <span class="text-zinc-600 font-normal">(pisahkan dengan koma)</span></div>
                <input type="text" name="seoKeywords" value="<%= settings.seoKeywords||'' %>" class="hm-input" placeholder="topup mod ff, key mod ff, cheat free fire">
                <div class="text-[10px] mt-1" style="color:var(--text-3);">Kata kunci yang ingin ditarget di Google (mis. "topup mod ff", "key mod ff").</div>
            </div>
            <div>
                <div class="setting-row-label">Marquee Text (teks berjalan)</div>
                <input type="text" name="marqueeText" value="<%= settings.marqueeText %>" class="hm-input">
            </div>
            <div>
                <div class="setting-row-label">URL Logo (gambar navbar)</div>
                <input type="text" name="logoUrl" value="<%= settings.logoUrl||'' %>" class="hm-input" placeholder="https://... atau /uploads/logo.png">
                <% if (settings.logoUrl) { %>
                <div class="mt-1.5 flex items-center gap-2">
                    <img src="<%= settings.logoUrl %>" alt="Logo preview" style="height:32px;max-width:120px;object-fit:contain;border-radius:4px;background:#f4f4f5;padding:2px 6px;">
                    <span class="text-[10px]" style="color:var(--text-3);">Preview logo</span>
                </div>
                <% } %>
            </div>
            <div>
                <div class="setting-row-label">URL Logo Text / Wordmark (gambar tulisan nama toko)</div>
                <input type="text" name="logoTextUrl" value="<%= settings.logoTextUrl||'' %>" class="hm-input" placeholder="https://... atau /uploads/logo-text.png">
                <div class="text-[10px] mt-1" style="color:var(--text-3);">Kalau diisi, navbar pakai GAMBAR ini sebagai tulisan nama toko (bukan teks font biasa). Kosongkan untuk kembali ke teks otomatis dari Nama Toko.</div>
                <% if (settings.logoTextUrl) { %>
                <div class="mt-1.5 flex items-center gap-2">
                    <img src="<%= settings.logoTextUrl %>" alt="Logo text preview" style="height:32px;max-width:200px;object-fit:contain;border-radius:4px;background:#f4f4f5;padding:2px 6px;">
                    <span class="text-[10px]" style="color:var(--text-3);">Preview logo text</span>
                </div>
                <% } %>
            </div>
            <!-- FIX (diminta client 22 Agu 2026): kelola logo metode pembayaran
                 (DANA, GoPay, dll) -- kotak rectangle rounded berisi logo asli,
                 bukan cuma teks badge. Admin isi URL logo resmi masing-masing
                 (didapat dari kanal resmi e-wallet/bank, BUKAN logo yang
                 di-hardcode di kode karena itu aset berhak cipta pihak
                 ketiga). Disimpan sebagai JSON array di textarea sederhana. -->
            <div class="pt-2 border-t border-white/5">
                <div class="text-xs font-bold text-red-400 mb-3 flex items-center gap-2">
                    <iconify-icon icon="mdi:credit-card-outline"></iconify-icon> Metode Pembayaran (Logo Footer)
                </div>
                <div id="paymentMethodsRows" class="space-y-2 mb-2"></div>
                <button type="button" onclick="addPaymentMethodRow()" class="text-[11px] text-red-400 hover:text-red-300 flex items-center gap-1">
                    <iconify-icon icon="mdi:plus"></iconify-icon> Tambah Metode Pembayaran
                </button>
                <input type="hidden" name="paymentMethods" id="paymentMethodsInput">
                <div class="text-[10px] mt-1.5" style="color:var(--text-3);">Kosongkan semua untuk tampilkan badge teks default (QRIS/Transfer Bank/E-Wallet).</div>
            </div>
            <div class="pt-2 border-t border-white/5">
                <div class="text-xs font-bold text-red-400 mb-3 flex items-center gap-2">
                    <iconify-icon icon="mdi:phone"></iconify-icon> Kontak
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div>
                        <div class="setting-row-label">WhatsApp</div>
                        <input type="text" name="whatsapp" value="<%= settings.contact?.whatsapp||'' %>" class="hm-input" placeholder="628xxxxxxxxx">
                    </div>
                    <div>
                        <div class="setting-row-label">Telegram</div>
                        <input type="text" name="telegram" value="<%= settings.contact?.telegram||'' %>" class="hm-input" placeholder="username">
                    </div>
                    <div>
                        <div class="setting-row-label">Email</div>
                        <input type="email" name="email" value="<%= settings.contact?.email||'' %>" class="hm-input">
                    </div>
                </div>
                <div class="mt-3">
                    <div class="setting-row-label">Link Download APK / Channel</div>
                    <input type="url" name="downloadUrl" value="<%= settings.contact?.downloadUrl||'' %>" class="hm-input" placeholder="https://whatsapp.com/channel/... atau link Google Drive APK">
                    <div class="text-[10px] mt-1" style="color:var(--text-3);">Ditampilkan sebagai tombol "Download APK" di halaman produk. Kosongkan untuk menyembunyikan tombol.</div>
                </div>
                <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <div class="setting-row-label">Link Saluran WA (Channel)</div>
                        <input type="url" name="waChannel" value="<%= settings.contact?.waChannel||'' %>" class="hm-input" placeholder="https://whatsapp.com/channel/...">
                        <div class="text-[10px] mt-1" style="color:var(--text-3);">Icon "Saluran WA" di homepage. Kosongkan untuk menyembunyikan icon.</div>
                    </div>
                    <div>
                        <div class="setting-row-label">Link Grup WA</div>
                        <input type="url" name="waGroup" value="<%= settings.contact?.waGroup||'' %>" class="hm-input" placeholder="https://chat.whatsapp.com/...">
                        <div class="text-[10px] mt-1" style="color:var(--text-3);">Icon "GB WA Group" di homepage. Kosongkan untuk menyembunyikan icon.</div>
                    </div>
                </div>
                <div class="mt-3 pt-3 border-t border-white/5">
                    <div class="text-xs font-bold text-emerald-400 mb-3 flex items-center gap-2">
                        <iconify-icon icon="mdi:whatsapp"></iconify-icon> Grup Buyer VIP
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <div class="setting-row-label">Nama Grup</div>
                            <input type="text" name="buyerGroupName" value="<%= settings.buyerGroupName||'' %>" class="hm-input" placeholder="BUYER VIP BY AGHA NL">
                        </div>
                        <div>
                            <div class="setting-row-label">Link Grup WhatsApp</div>
                            <input type="url" name="buyerGroupUrl" value="<%= settings.buyerGroupUrl||'' %>" class="hm-input" placeholder="https://chat.whatsapp.com/...">
                        </div>
                    </div>
                    <div class="text-[10px] mt-1" style="color:var(--text-3);">Tombol "Gabung Grup" muncul otomatis di halaman invoice setelah buyer berhasil dapat key (semua produk). Kosongkan untuk menyembunyikan tombol.</div>
                </div>
                <div class="mt-3 pt-3 border-t border-white/5">
                    <div class="text-xs font-bold text-yellow-400 mb-3 flex items-center gap-2">
                        <iconify-icon icon="mdi:crown"></iconify-icon> Grup Reseller VIP
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <div class="setting-row-label">Nama Grup</div>
                            <input type="text" name="resellerGroupName" value="<%= settings.resellerGroupName||'' %>" class="hm-input" placeholder="RESELLER VIP BY AGHA NL">
                        </div>
                        <div>
                            <div class="setting-row-label">Link Grup WhatsApp</div>
                            <input type="url" name="resellerGroupUrl" value="<%= settings.resellerGroupUrl||'' %>" class="hm-input" placeholder="https://chat.whatsapp.com/...">
                        </div>
                    </div>
                    <div class="text-[10px] mt-1" style="color:var(--text-3);">Tombol "Gabung Grup Reseller" muncul otomatis di halaman /reseller begitu status reseller user diaktifkan admin. Kosongkan untuk menyembunyikan tombol.</div>
                </div>
                <div class="mt-3">
                    <div class="setting-row-label">Fonnte API Token (notif WA otomatis ke admin saat stok habis)</div>
                    <input type="text" name="fonnteToken" value="<%= settings.fonnteToken||'' %>" class="hm-input" placeholder="Isi token dari fonnte.com (opsional)">
                    <div class="text-[10px] mt-1" style="color:var(--text-3);">Kosongkan jika tidak digunakan. Daftar gratis di <a href="https://fonnte.com" target="_blank" class="text-red-400 underline">fonnte.com</a>, hubungkan WA, lalu copy token-nya ke sini.</div>
                </div>
            </div>
            <button type="submit" class="btn-primary w-full justify-center py-3 text-sm">
                <iconify-icon icon="mdi:content-save"></iconify-icon> Simpan Pengaturan
            </button>
        </form>
    </div>

    <!-- Kategori -->
    <div class="neon-card p-5 mb-3" id="categoryManagerSection">
        <div class="text-xs font-bold text-red-400 mb-4 flex items-center gap-2">
            <iconify-icon icon="mdi:tag-multiple"></iconify-icon> Kategori Produk
        </div>
        <!-- FIX (24 Agu 2026, diminta client): section ini yang dulu berupa
             3 tombol tetap "Platform" (Android/iOS/PC) sebelum digabung
             jadi sistem kategori dinamis (22 Agu 2026). Client tidak
             menemukan section ini karena posisinya jauh di tengah halaman
             Settings dan tidak ada penanda jelas kalau ini tempat atur
             Android/iOS/PC. Ditambahkan: (1) penjelasan eksplisit di sini,
             (2) tombol "Tambah Cepat" yang langsung mengisi 3 kategori
             platform standar sekali klik, tanpa perlu paham syntax
             id:Label manual. Textarea di bawah tetap ada untuk kategori
             custom lain (nama game, dst). -->
        <p class="text-[11px] text-zinc-500 mb-3 leading-relaxed">
            Kategori di sini dipakai untuk DUA hal: platform (Android/iOS/PC) dan nama game
            (Free Fire, Mobile Legends, dst) -- keduanya sekarang jadi satu sistem yang sama,
            supaya 1 produk bisa dicentang lebih dari satu kategori (misal "Android" + "Free Fire").
        </p>
        <button type="button" onclick="quickAddPlatformCategories()" class="w-full mb-3 py-2 rounded-lg text-xs font-bold flex items-center justify-center gap-1.5" style="background:rgba(34,197,94,.1);color:#4ade80;border:1px solid rgba(34,197,94,.25);cursor:pointer;">
            <iconify-icon icon="mdi:cellphone-link"></iconify-icon> Tambah Cepat: Android, iOS, PC
        </button>
        <form id="categoryForm" class="space-y-3">
            <div>
                <div class="setting-row-label">Daftar kategori (satu per baris, format: id:Label)</div>
                <textarea name="categories" id="categoryTextarea" rows="6" class="hm-input font-mono text-xs"><% (settings.categories||[]).forEach(cat => { %><%= cat %>:<%= (settings.categoryLabels||{})[cat]||cat %>
<% }) %></textarea>
                <p class="text-[10px] text-zinc-600 mt-1">Contoh: freefire:FREE FIRE</p>
            </div>
            <button type="submit" class="btn-primary w-full justify-center py-2.5 text-sm">
                <iconify-icon icon="mdi:content-save"></iconify-icon> Simpan Kategori
            </button>
        </form>
    </div>

    <!-- BANNER CAROUSEL -->
    <div class="neon-card p-5 mb-3">
        <div class="text-xs font-bold text-red-400 mb-4 flex items-center gap-2">
            <iconify-icon icon="mdi:image-multiple"></iconify-icon> Banner Carousel
        </div>

        <!-- Form tambah banner -->
        <form id="bannerAddForm" enctype="multipart/form-data" class="space-y-3 mb-5" onsubmit="addBanner(event)">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <div class="setting-row-label">Judul Banner (opsional)</div>
                    <input type="text" name="title" class="hm-input" placeholder="Contoh: PROMO SPESIAL">
                </div>
                <div>
                    <div class="setting-row-label">Subjudul (opsional)</div>
                    <input type="text" name="subtitle" class="hm-input" placeholder="Contoh: Diskon 20% hari ini">
                </div>
            </div>
            <div>
                <div class="setting-row-label">Link klik banner (opsional)</div>
                <input type="text" name="link" class="hm-input" placeholder="Contoh: /buy/xxx atau https://...">
            </div>
            <div>
                <div class="setting-row-label">Gambar Banner</div>
                <input type="file" name="bannerImg" accept="image/jpeg,image/png,image/webp" class="hm-input text-xs py-2" onchange="previewBannerFile(event)">
                <div id="bannerFilePreview" class="mt-2 hidden">
                    <img id="bannerFileImg" src="" class="w-full h-28 object-cover rounded-xl border border-zinc-500/25">
                </div>
            </div>
            <div>
                <div class="setting-row-label">Atau URL gambar</div>
                <input type="text" name="imageUrl" class="hm-input" placeholder="https://..." oninput="previewBannerUrl(this.value)" id="bannerUrlInput">
            </div>
            <div id="bannerUrlPreview" class="hidden">
                <img id="bannerUrlImg" src="" class="w-full h-28 object-cover rounded-xl border border-zinc-500/25">
            </div>
            <button type="submit" id="bannerAddBtn" class="btn-primary w-full justify-center py-2.5 text-sm">
                <iconify-icon icon="mdi:plus-circle"></iconify-icon> Tambah Banner
            </button>
        </form>

        <!-- Daftar banner -->
        <div class="setting-row-label mb-3">Banner Aktif</div>
        <div id="bannerList" class="space-y-2">
            <div class="text-xs text-zinc-600 text-center py-3">Memuat...</div>
        </div>
    </div>

    <!-- QRIS Payment -->
    <div class="neon-card p-5 mb-3">
        <div class="text-xs font-bold text-red-400 mb-4 flex items-center gap-2">
            <iconify-icon icon="mdi:qrcode-scan"></iconify-icon> Pengaturan QRIS
        </div>

        <!-- Mode Selector -->
        <div class="flex gap-2 mb-4">
            <button type="button" id="modeStaticBtn" onclick="setQrisMode('static')"
                class="flex-1 py-2.5 rounded-xl text-xs font-bold border transition-all flex items-center justify-center gap-1.5
                <%= (settings.qrisMode||'static')==='static' ? 'bg-red-500/20 border-zinc-500/50 text-red-300' : 'bg-white/3 border-white/10 text-zinc-500' %>">
                <iconify-icon icon="mdi:image"></iconify-icon> Statis (Gambar)
            </button>
            <button type="button" id="modeApiBtn" onclick="setQrisMode('api')"
                class="flex-1 py-2.5 rounded-xl text-xs font-bold border transition-all flex items-center justify-center gap-1.5
                <%= (settings.qrisMode||'static')==='api' ? 'bg-red-500/20 border-zinc-500/50 text-red-300' : 'bg-white/3 border-white/10 text-zinc-500' %>">
                <iconify-icon icon="mdi:api"></iconify-icon> API (PakKasir)
            </button>
        </div>

        <!-- QRIS Statis -->
        <div id="sectionStatic" class="<%= (settings.qrisMode||'static')==='static' ? '' : 'hidden' %>">
            <p class="text-[11px] text-zinc-500 mb-3">Upload foto QRIS dari rekening kamu (GoPay, DANA, OVO, atau QRIS Merchant). Pembayaran dikonfirmasi manual oleh admin.</p>
            <% if (settings.qrisStaticImage) { %>
            <div class="mb-3 flex flex-col items-center gap-2">
                <img src="<%= settings.qrisStaticImage %>?t=<%= Date.now() %>" class="rounded-xl border border-emerald-500/30" style="max-width:180px" id="qrisPreviewImg">
                <span class="text-[10px] text-emerald-400 flex items-center gap-1"><iconify-icon icon="mdi:check-circle"></iconify-icon> QRIS aktif</span>
            </div>
            <% } else { %>
            <div class="mb-3 p-4 rounded-xl bg-yellow-500/8 border border-yellow-500/20 text-center">
                <iconify-icon icon="mdi:alert-circle-outline" class="text-yellow-400 text-2xl mb-1 block"></iconify-icon>
                <p class="text-[11px] text-yellow-400">Belum ada gambar QRIS. Upload sekarang.</p>
            </div>
            <% } %>
            <form id="qrisStaticForm" enctype="multipart/form-data" class="space-y-2">
                <input type="file" name="qrisImage" accept="image/jpeg,image/png,image/webp" class="hm-input text-xs py-2">
                <button type="submit" class="btn-primary w-full justify-center py-2.5 text-sm">
                    <iconify-icon icon="mdi:upload"></iconify-icon> Upload Gambar QRIS
                </button>
            </form>
        </div>

        <!-- QRIS API (PakKasir / GensPay) -->
        <div id="sectionApi" class="<%= (settings.qrisMode||'static')==='api' ? '' : 'hidden' %> space-y-3">
            <div class="p-3 rounded-xl bg-red-500/8 border border-red-500/20 text-[11px] text-red-400 mb-2">
                <iconify-icon icon="mdi:alert"></iconify-icon> Pastikan API key dan URL yang dimasukkan sudah benar. Test koneksi sebelum menyimpan.
            </div>

            <!-- Gateway Selector -->
            <div class="flex gap-2 mb-1">
                <button type="button" id="gwPakasirBtn" onclick="setApiGateway('pakasir')"
                    class="flex-1 py-2 rounded-xl text-[11px] font-bold border transition-all flex items-center justify-center gap-1.5
                    <%= (settings.apiGateway||'pakasir')==='pakasir' ? 'bg-red-500/20 border-zinc-500/50 text-red-300' : 'bg-white/3 border-white/10 text-zinc-500' %>">
                    <iconify-icon icon="mdi:api"></iconify-icon> PakKasir
                </button>
                <button type="button" id="gwGenspayBtn" onclick="setApiGateway('genspay')"
                    class="flex-1 py-2 rounded-xl text-[11px] font-bold border transition-all flex items-center justify-center gap-1.5
                    <%= (settings.apiGateway||'pakasir')==='genspay' ? 'bg-red-500/20 border-zinc-500/50 text-red-300' : 'bg-white/3 border-white/10 text-zinc-500' %>">
                    <iconify-icon icon="mdi:api"></iconify-icon> GensPay
                </button>
            </div>

            <!-- PakKasir Form -->
            <form id="pakasirForm" class="space-y-3 <%= (settings.apiGateway||'pakasir')==='pakasir' ? '' : 'hidden' %>" data-gateway-form="pakasir">
                <div>
                    <div class="setting-row-label">API Key</div>
                    <input type="text" name="apiKey" value="<%= settings.pakasir?.apiKey||'' %>" class="hm-input font-mono text-xs" placeholder="masukkan API key PakKasir">
                </div>
                <div>
                    <div class="setting-row-label">Project Name</div>
                    <input type="text" name="project" value="<%= settings.pakasir?.project||'' %>" class="hm-input" placeholder="nama project kamu">
                </div>
                <div>
                    <div class="setting-row-label">API Base URL <span class="text-zinc-600 font-normal">(hostname, tanpa https://)</span></div>
                    <input type="text" name="apiBaseUrl" value="<%= settings.pakasir?.apiBaseUrl||'api.pakasir.com' %>" class="hm-input font-mono text-xs" placeholder="api.pakasir.com">
                </div>
                <button type="button" onclick="testPakasir()" class="w-full py-2 rounded-xl text-xs font-bold text-zinc-400 border border-white/10 bg-white/3 hover:bg-white/8 transition-all flex items-center justify-center gap-1.5">
                    <iconify-icon icon="mdi:wifi-check"></iconify-icon> Test Koneksi API
                </button>
                <div id="testResult" class="hidden text-[11px] p-2.5 rounded-lg"></div>
                <button type="submit" class="btn-primary w-full justify-center py-2.5 text-sm">
                    <iconify-icon icon="mdi:content-save"></iconify-icon> Simpan Pengaturan PakKasir
                </button>
            </form>

            <!-- GensPay Form -->
            <form id="genspayForm" class="space-y-3 <%= (settings.apiGateway||'pakasir')==='genspay' ? '' : 'hidden' %>" data-gateway-form="genspay">
                <div>
                    <div class="setting-row-label">API Key</div>
                    <input type="text" name="apiKey" value="<%= settings.genspay?.apiKey||'' %>" class="hm-input font-mono text-xs" placeholder="masukkan API key GensPay">
                </div>
                <div>
                    <div class="setting-row-label">Base URL <span class="text-zinc-600 font-normal">(default: genspay.my.id/api/v1)</span></div>
                    <input type="text" name="baseUrl" value="<%= settings.genspay?.baseUrl||'https://genspay.my.id/api/v1' %>" class="hm-input font-mono text-xs" placeholder="https://genspay.my.id/api/v1">
                </div>
                <p class="text-[10px] text-zinc-600"><iconify-icon icon="mdi:book-open-outline" style="vertical-align:-2px;"></iconify-icon> Dokumentasi: <a href="https://genspay.my.id/docs" target="_blank" class="text-red-400 underline">genspay.my.id/docs</a></p>
                <div class="p-2.5 rounded-lg bg-white/3 border border-white/10 text-[10px] text-zinc-500 space-y-1">
                    <div class="text-zinc-400 font-semibold flex items-center gap-1">
                        <iconify-icon icon="mdi:link-variant"></iconify-icon> Webhook URL — WAJIB diisi di dashboard GensPay
                    </div>
                    <div class="text-zinc-400">Tanpa ini, key produk tidak auto-kirim kalau pembeli menutup halaman sebelum status "paid" sempat kecek. Copy URL ini ke kolom Webhook URL project GensPay kamu (Settings → Edit project).</div>
                    <div class="flex gap-1.5 mt-1">
                        <input type="text" id="genspayWebhookUrl" readonly class="hm-input font-mono text-[11px] flex-1" value="">
                        <button type="button" onclick="copyWebhookUrl('genspayWebhookUrl')" class="px-3 py-2 rounded-lg text-xs font-bold text-red-300 border border-red-500/30 bg-red-500/10 hover:bg-red-500/20 transition-all whitespace-nowrap">
                            <iconify-icon icon="mdi:content-copy"></iconify-icon>
                        </button>
                    </div>
                </div>
                <button type="button" onclick="testGenspay()" class="w-full py-2 rounded-xl text-xs font-bold text-zinc-400 border border-white/10 bg-white/3 hover:bg-white/8 transition-all flex items-center justify-center gap-1.5">
                    <iconify-icon icon="mdi:wifi-check"></iconify-icon> Test Koneksi API
                </button>
                <div id="testResultGenspay" class="hidden text-[11px] p-2.5 rounded-lg"></div>
                <button type="submit" class="btn-primary w-full justify-center py-2.5 text-sm">
                    <iconify-icon icon="mdi:content-save"></iconify-icon> Simpan Pengaturan GensPay
                </button>
            </form>
        </div>

        <!-- Simpan Mode -->
        <input type="hidden" id="qrisModeVal" value="<%= settings.qrisMode||'static' %>">
    </div>

    <!-- Wallet / Saldo (Reseller) -->
    <div class="neon-card p-5 mb-3">
        <div class="text-xs font-bold text-red-400 mb-4 flex items-center gap-2">
            <iconify-icon icon="mdi:wallet"></iconify-icon> Pengaturan Wallet / Saldo
        </div>
        <p class="text-[11px] text-zinc-500 mb-3">Nominal minimum top up saldo wallet. Fitur ini khusus untuk Reseller VIP.</p>
        <form id="walletSettingsForm" class="space-y-3">
            <div>
                <div class="setting-row-label">Minimal Top Up Reseller VIP (Rp)</div>
                <input type="number" name="resellerMinDeposit" value="<%= settings.resellerMinDeposit || 50000 %>" min="1000" class="hm-input" placeholder="50000">
            </div>
            <button type="submit" class="btn-primary w-full justify-center py-2.5 text-sm">
                <iconify-icon icon="mdi:content-save"></iconify-icon> Simpan Minimal Top Up
            </button>
        </form>
    </div>

    <!-- Reseller VIP -->
    <div class="neon-card p-5 mb-3" style="border-color:rgba(234,179,8,.2)">
        <div class="text-xs font-bold mb-4 flex items-center gap-2" style="color:#fbbf24">
            <iconify-icon icon="mdi:crown"></iconify-icon> Program Reseller VIP
        </div>
        <form id="resellerSettingsForm" class="space-y-3">
            <div class="flex items-center justify-between p-3 rounded-xl" style="background:rgba(234,179,8,.06);border:1px solid rgba(234,179,8,.15)">
                <div>
                    <div class="text-xs font-semibold text-white">Aktifkan Program Reseller</div>
                    <div class="text-[10px] text-zinc-500 mt-0.5">Tampilkan banner upgrade reseller di halaman utama</div>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" name="resellerEnabled" id="resellerEnabledToggle" class="sr-only peer" <%= (settings.resellerEnabled !== false) ? 'checked' : '' %>>
                    <div class="w-9 h-5 bg-zinc-700 peer-focus:ring-2 peer-focus:ring-yellow-500/30 rounded-full peer peer-checked:bg-yellow-500 transition-all after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:after:translate-x-4"></div>
                </label>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <div class="setting-row-label">Biaya Upgrade (Rp)</div>
                    <input type="number" name="resellerPrice" value="<%= settings.resellerPrice || 50000 %>" min="1000" class="hm-input" placeholder="50000">
                </div>
                <div>
                    <div class="setting-row-label">Diskon Reseller (%)</div>
                    <input type="number" name="resellerDiscount" value="<%= settings.resellerDiscount || 20 %>" min="1" max="99" class="hm-input" placeholder="20">
                </div>
            </div>
            <div>
                <div class="setting-row-label">Catatan / Tagline</div>
                <input type="text" name="resellerNote" value="<%= settings.resellerNote || 'Dapatkan diskon eksklusif untuk semua produk!' %>" class="hm-input">
            </div>
            <div class="p-3 rounded-xl text-[11px]" style="background:rgba(234,179,8,.06);border:1px solid rgba(234,179,8,.12);color:#a1a1aa">
                <iconify-icon icon="mdi:information-outline" class="text-yellow-400 align-middle mr-1"></iconify-icon>
                Preview: User hemat <strong class="text-yellow-400" id="discPreview"><%= settings.resellerDiscount || 20 %>%</strong> otomatis di semua produk saat login sebagai reseller.
            </div>
            <button type="submit" class="w-full py-2.5 rounded-xl text-xs font-black flex items-center justify-center gap-2" style="background:#d97706;color:#000">
                <iconify-icon icon="mdi:crown"></iconify-icon> Simpan Pengaturan Reseller
            </button>
        </form>
    </div>

    <!-- Kredensial Admin -->
    <div class="neon-card p-5 mb-3">
        <div class="text-xs font-bold text-red-400 mb-4 flex items-center gap-2">
            <iconify-icon icon="mdi:shield-account"></iconify-icon> Kredensial Admin
        </div>
        <form id="credForm" class="space-y-3">
            <div>
                <div class="setting-row-label">Username Admin Baru</div>
                <input type="text" name="adminUsername" value="<%= settings.adminUsername %>" class="hm-input">
            </div>
            <div>
                <div class="setting-row-label">Password Baru</div>
                <input type="password" name="newPassword" class="hm-input" placeholder="Kosongkan jika tidak ingin ubah">
            </div>
            <button type="submit" class="btn-danger w-full justify-center py-2.5 text-sm">
                <iconify-icon icon="mdi:shield-key"></iconify-icon> Update Kredensial
            </button>
        </form>
    </div>

    <!-- Export / Import Data -->
    <div class="neon-card p-5 mb-3">
        <div class="text-xs font-bold text-red-400 mb-4 flex items-center gap-2">
            <iconify-icon icon="mdi:database-sync"></iconify-icon> Backup & Restore Database
        </div>
        <p class="text-[11px] text-zinc-500 mb-4">Download semua data (produk, transaksi, user, dll) sebagai file JSON. Berguna untuk backup atau pindah server.</p>
        <div class="grid grid-cols-2 gap-3">
            <a href="/admin/export" target="_blank"
               class="flex items-center justify-center gap-2 px-4 py-3 rounded-xl text-xs font-bold transition-all hover:scale-[1.02]"
               style="background:var(--neon-purple-10);border:1px solid var(--neon-purple-25);color:var(--accent-color);">
                <iconify-icon icon="mdi:download"></iconify-icon> Export Database
            </a>
            <div>
                <button onclick="document.getElementById('importInput').click()"
                    class="w-full flex items-center justify-center gap-2 px-4 py-3 rounded-xl text-xs font-bold transition-all hover:scale-[1.02]"
                    style="background:rgba(234,179,8,.1);border:1px solid rgba(234,179,8,.3);color:#b45309;">
                    <iconify-icon icon="mdi:upload"></iconify-icon> Import Database
                </button>
                <input type="file" id="importInput" accept=".json" class="hidden" onchange="importDB(event)">
            </div>
        </div>
        <div id="importStatus" class="mt-3 hidden"></div>
    </div>
</div>

</div><!-- /max-w -->

