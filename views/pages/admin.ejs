            <div style="flex:0 0 64px">
                <select name="pricingUnits" class="hm-input text-xs">
                    <option value="d" ${unit === 'd' ? 'selected' : ''}>Hari</option>
                    <option value="h" ${unit === 'h' ? 'selected' : ''}>Jam</option>
