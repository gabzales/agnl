// ── ADJUST SALDO WALLET USER ──
// ── FILTER TIPE USER: Semua / Reseller / User Biasa (diminta client 22
// Agu 2026: "susah cari reseller buat di-add saldo kalau user-nya
// banyak") ──
let currentUserTypeFilter = 'all';

function filterUserType(type) {
    currentUserTypeFilter = type;
    document.querySelectorAll('.user-type-btn').forEach(b => b.classList.remove('active'));
    document.getElementById(`userTypeBtn${type === 'all' ? 'All' : type === 'reseller' ? 'Reseller' : 'Regular'}`)?.classList.add('active');
    currentUserPage = 1; // reset ke halaman 1 setiap ganti filter
    applyUserFilters();
}

// Fungsi terpadu: gabungkan filter tipe (Semua/Reseller/User Biasa) +
// search term + pagination, supaya ketiganya konsisten dan tidak saling
// menimpa satu sama lain.
function applyUserFilters() {
    const term = (document.getElementById('userSearchInput')?.value || '').trim().toLowerCase();
    const allCards = Array.from(document.querySelectorAll('.user-card'));

    // Tahap 1: filter berdasar tipe (reseller/regular/all) + search term.
    // Hasilnya adalah daftar kartu yang LOLOS kedua kriteria ini.
    const matchingCards = allCards.filter(card => {
        const isReseller = card.getAttribute('data-is-reseller') === '1';
        const typeMatch = currentUserTypeFilter === 'all' || (currentUserTypeFilter === 'reseller' && isReseller) || (currentUserTypeFilter === 'regular' && !isReseller);
        if (!typeMatch) return false;
        if (!term) return true;
        const hay = card.getAttribute('data-search') || '';
        return hay.includes(term);
    });

    // Sembunyikan dulu semua kartu, baru tampilkan yang cocok
    allCards.forEach(card => { card.style.display = 'none'; });

    const pagination = document.getElementById('userPagination');
    const empty = document.getElementById('userSearchEmpty');

    if (term) {
        // Mode pencarian: tampilkan SEMUA hasil yang cocok, pagination
        // disembunyikan sementara (supaya hasil tidak tersebar di banyak halaman).
        matchingCards.forEach(card => { card.style.display = ''; });
        pagination?.classList.add('hidden');
        empty?.classList.toggle('hidden', matchingCards.length > 0);
    } else {
        // Tanpa search: terapkan pagination pada hasil filter tipe.
        empty?.classList.add('hidden');
        const totalPages = Math.max(1, Math.ceil(matchingCards.length / USERS_PER_PAGE));
        currentUserPage = Math.min(Math.max(1, currentUserPage), totalPages);
        const start = (currentUserPage - 1) * USERS_PER_PAGE;
        const end = start + USERS_PER_PAGE;
        matchingCards.forEach((card, i) => { card.style.display = (i >= start && i < end) ? '' : 'none'; });

        if (matchingCards.length > USERS_PER_PAGE) {
            pagination?.classList.remove('hidden');
            const pageInfo = document.getElementById('userPageInfo');
            const prevBtn = document.getElementById('userPrevBtn');
            const nextBtn = document.getElementById('userNextBtn');
            if (pageInfo) pageInfo.textContent = `Halaman ${currentUserPage} / ${totalPages}`;
            if (prevBtn) prevBtn.disabled = currentUserPage <= 1;
            if (nextBtn) nextBtn.disabled = currentUserPage >= totalPages;
        } else {
            pagination?.classList.add('hidden');
        }
    }
}

// ── Pagination user (diminta client 22 Agu 2026) ──
// Semua card user tetap ada di DOM (server-rendered), pagination cuma
// mengatur display:none/'' berdasar halaman aktif. Saat search aktif,
// pagination dinonaktifkan sementara (tampilkan SEMUA hasil yang cocok,
// tanpa dibatasi per-halaman) supaya pencarian tidak membingungkan kalau
// hasilnya tersebar di banyak halaman.
const USERS_PER_PAGE = 20;
let currentUserPage = 1;

function renderUserPage() {
    applyUserFilters();
}

function changeUserPage(delta) {
    currentUserPage += delta;
    applyUserFilters();
    document.getElementById('pane-users')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function filterUsers(q) {
    currentUserPage = 1; // reset ke halaman 1 tiap kali search berubah
    applyUserFilters();
}

document.addEventListener('DOMContentLoaded', renderUserPage);
if (document.readyState !== 'loading') renderUserPage();

