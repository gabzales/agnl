    document.getElementById('modeStaticBtn').className = `flex-1 py-2.5 rounded-xl text-xs font-bold border transition-all flex items-center justify-center gap-1.5 ${isStatic ? 'bg-red-500/20 border-zinc-500/50 text-red-300' : 'bg-white/3 border-white/10 text-zinc-500'}`;
