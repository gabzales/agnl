// ─── Restock manual dari DripStore (diminta client 16 Sep 2026) ───
async function restockFromDripstore(i, btn) {
  const opt = pricingOptions[i];
  if (!opt.dripstoreVariantId) { showToast('Isi dulu DripStore Variant ID buat durasi ini', 'error'); return; }
  const qtyStr = prompt(`Generate berapa key baru dari DripStore buat "${currentProduct.name}" (${opt.days}${opt.unit==='h'?'jam':'hari'})?`, '10');
  if (qtyStr === null) return;
  const qty = parseInt(qtyStr.replace(/[^0-9]/g, ''), 10);
  if (!qty || qty <= 0) { showToast('Jumlah tidak valid', 'error'); return; }

  // Busy-guard: cegah klik dobel yang bisa bikin 2 request restock nembak
  // bersamaan buat durasi yang sama sebelum request pertama selesai.
  if (btn) { if (btn.dataset.busy === '1') return; btn.dataset.busy = '1'; btn.disabled = true; btn.style.opacity = '0.5'; }

  showToast('Membuat proposal restock — saldo DripStore belum dipotong.', 'info');
  try {
    const r = await fetch(`/admin/product/${currentProduct.id}/restock-dripstore`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ days: opt.days, unit: opt.unit, quantity: qty })
    });
    const d = await r.json();
    if (d.success) {
      showToast(`Proposal restock #${d.request?.id?.slice(0,8) || ''} dibuat. Approve dari Admin > Pending Restock.`, 'success');
    } else {
      showToast('Gagal restock: ' + (d.message || 'error tidak diketahui'), 'error');
    }
  } catch (err) {
    showToast('Gagal konek ke server: ' + err.message, 'error');
  } finally {
    if (btn) { btn.dataset.busy = '0'; btn.disabled = false; btn.style.opacity = ''; }
  }
}

