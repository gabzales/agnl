<%
const pageTitle = 'Edit Produk';
const noIndex = true; // halaman admin, jangan di-index Google
%>
<style>
/* FIX (redesign 22 Agu 2026): style lokal file ini didesain untuk
   background gelap (rgba(255,255,255,...) transparan tipis + color:#fff),
   sekarang background global sudah putih (layout.ejs). */
.hm-input{width:100%;padding:10px 14px;border-radius:10px;background:var(--bg-section);border:1.5px solid var(--border-md);color:var(--text-1);font-size:13px;transition:all .2s;font-family:'Inter',sans-serif;}
.hm-input:focus{outline:none;border-color:var(--neon-purple-35);background:var(--neon-purple-10);}
.section-card{background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:20px;margin-bottom:16px;box-shadow:0 1px 2px rgba(0,0,0,.03);}
.key-chip{display:inline-flex;align-items:center;gap:4px;padding:3px 8px;border-radius:6px;font-size:10px;font-family:monospace;background:var(--neon-purple-12);border:1px solid var(--neon-purple-25);color:#4f46e5;margin:2px;}
.text-zinc-300 { color: var(--text-1) !important; }
.text-zinc-400 { color: var(--text-2) !important; }
.text-zinc-500 { color: var(--text-2) !important; }
.text-zinc-600 { color: var(--text-3) !important; }
.text-white { color: var(--text-1) !important; }
.bg-white\/5 { background: var(--bg-hover) !important; }
.bg-white\/10 { background: var(--border) !important; }
.border-white\/10 { border-color: var(--border) !important; }
.border-white\/5 { border-color: var(--bg-hover) !important; }
.hover\:text-white:hover { color: var(--text-1) !important; }
.hover\:bg-white\/5:hover { background: var(--bg-hover) !important; }
</style>

<div class="min-h-screen pt-20 pb-24 px-4">
<div class="max-w-2xl mx-auto">

  <!-- Header -->
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-black text-white">Edit Produk</h1>
      <p class="text-zinc-500 text-sm mt-0.5" id="productNameLabel">Memuat...</p>
    </div>
    <a href="/admin" class="flex items-center gap-1.5 px-3 py-2 rounded-lg border border-white/10 text-zinc-400 hover:text-white hover:bg-white/5 text-xs font-bold transition-all">
      <iconify-icon icon="mdi:arrow-left"></iconify-icon> Kembali
    </a>
  </div>

  <!-- ── GAMBAR PRODUK ── -->
  <div class="section-card">
    <h2 class="text-sm font-black text-white mb-4 flex items-center gap-2">
      <iconify-icon icon="mdi:image" class="text-red-400 text-lg"></iconify-icon> Gambar Produk
    </h2>
    <div id="imgPreviewWrap" class="w-full h-44 rounded-xl border-2 border-dashed border-red-500/30 bg-red-500/5 flex items-center justify-center overflow-hidden mb-3">
      <img id="imgPreview" src="" alt="" class="w-full h-full object-cover hidden">
      <span id="imgPlaceholder" class="text-zinc-600 text-sm">Belum ada gambar</span>
    </div>
    <input type="file" id="imgFileInput" accept="image/*" class="hidden" onchange="uploadBanner(event)">
    <div class="flex gap-2 mb-2">
      <button onclick="document.getElementById('imgFileInput').click()"
        class="flex-1 py-2 rounded-lg text-xs font-bold text-red-400 border border-red-500/30 hover:bg-red-500/10 transition-all flex items-center justify-center gap-1.5">
        <iconify-icon icon="mdi:upload" class="text-sm"></iconify-icon> Upload File
      </button>
    </div>
    <input type="text" id="imgUrlInput" class="hm-input text-sm" placeholder="Atau paste URL gambar (https://...)" oninput="previewImg(this.value)">
    <p class="text-[10px] text-zinc-600 mt-1.5">Gambar akan tampil di halaman produk pengguna</p>
  </div>

  <!-- ── DESKRIPSI PRODUK ── -->
  <div class="section-card">
    <h2 class="text-sm font-black text-white mb-1 flex items-center gap-2">
      <iconify-icon icon="mdi:text-box-outline" class="text-red-400 text-lg"></iconify-icon> Deskripsi Produk
    </h2>
    <p class="text-[11px] text-zinc-500 mb-3">Tampil di halaman detail produk (referensi fixaonly.com)</p>
    <textarea id="descriptionInput" class="hm-input text-sm" rows="6" placeholder="Deskripsi singkat produk...&#10;&#10;- Fitur cheat pertama&#10;- Fitur cheat kedua&#10;- Fitur cheat ketiga"></textarea>
    <p class="text-[10px] text-zinc-600 mt-1.5">Baris biasa jadi paragraf. Baris yang diawali <code class="text-red-400">-</code> otomatis jadi daftar fitur bercentang.</p>
  </div>

  <!-- ── TAB SHOWCASE & INFORMATION (diminta client 22 Agu 2026, referensi
       screenshot vipibmstore.com) ── -->
  <div class="section-card">
    <h2 class="text-sm font-black text-white mb-1 flex items-center gap-2">
      <iconify-icon icon="mdi:play-box-outline" class="text-red-400 text-lg"></iconify-icon> Tab Showcase & Information
    </h2>
    <p class="text-[11px] text-zinc-500 mb-3">Tampil sebagai 2 tab di halaman produk: video showcase dan info kompatibilitas + fitur</p>

    <div class="mb-3">
      <label class="text-[11px] text-zinc-400 font-bold mb-1 block">Link Video Showcase <span class="text-zinc-600 font-normal">(opsional, YouTube atau link video langsung)</span></label>
      <input type="url" id="videoUrlInput" class="hm-input text-sm" placeholder="https://youtube.com/watch?v=... atau https://.../video.mp4">
    </div>

    <div class="mb-3">
      <label class="text-[11px] text-zinc-400 font-bold mb-1 block">Compatibility <span class="text-zinc-600 font-normal">(opsional, teks bebas)</span></label>
      <input type="text" id="compatibilityInput" class="hm-input text-sm" placeholder="ANDROID NON ROOT">
    </div>

    <div>
      <label class="text-[11px] text-zinc-400 font-bold mb-1 block">Feature List <span class="text-zinc-600 font-normal">(opsional, satu fitur per baris)</span></label>
      <textarea id="featureListInput" class="hm-input text-sm" rows="5" placeholder="AIMBOT LEGIT&#10;AIMBOT RAGE&#10;ESP ALL&#10;MISC ALL PLAYER"></textarea>
    </div>
  </div>

  <!-- ── LINK CHANNEL / GRUP ── -->
  <div class="section-card">
    <h2 class="text-sm font-black text-white mb-1 flex items-center gap-2">
      <iconify-icon icon="mdi:link-variant" class="text-red-400 text-lg"></iconify-icon> Link Channel / Grup Produk
    </h2>
    <p class="text-[11px] text-zinc-500 mb-3">Muncul sebagai tombol "Download / Join Channel" di halaman invoice setelah buyer dapat key</p>
    <input type="url" id="channelUrlInput" class="hm-input text-sm" placeholder="https://whatsapp.com/channel/...">
  </div>

  <!-- ── LINK DOWNLOAD LANGSUNG (kartu produk) ── -->
  <div class="section-card">
    <h2 class="text-sm font-black text-white mb-1 flex items-center gap-2">
      <iconify-icon icon="mdi:download" class="text-red-400 text-lg"></iconify-icon> Link Download Langsung
    </h2>
    <p class="text-[11px] text-zinc-500 mb-3">Kalau diisi, tombol di KARTU PRODUK halaman utama berubah jadi "Download" (langsung buka link ini di tab baru), tidak lewat alur Beli/checkout. Kosongkan kalau produk ini tetap dijual normal.</p>
    <input type="url" id="downloadUrlInput" class="hm-input text-sm" placeholder="https://drive.google.com/... atau link APK/file">
  </div>

  <!-- ── STATUS ── -->
  <div class="section-card">
    <h2 class="text-sm font-black text-white mb-3 flex items-center gap-2">
      <iconify-icon icon="mdi:shield-check" class="text-red-400 text-lg"></iconify-icon> Status Produk
    </h2>
    <div class="flex gap-3">
      <button id="btn-active" onclick="setStatus('active')"
        class="flex-1 py-2.5 rounded-xl text-xs font-black border transition-all flex items-center justify-center gap-1.5">
        <iconify-icon icon="mdi:check-circle"></iconify-icon> Aktif
      </button>
      <button id="btn-inactive" onclick="setStatus('inactive')"
        class="flex-1 py-2.5 rounded-xl text-xs font-black border transition-all flex items-center justify-center gap-1.5">
        <iconify-icon icon="mdi:close-circle"></iconify-icon> Nonaktif
      </button>
    </div>
  </div>

  <!-- ── KATEGORI ── -->
  <!-- FIX (diminta client 22 Agu 2026): sebelumnya "Platform" (Android/iOS/PC)
       hardcode 3 tombol tetap, terpisah dari sistem kategori. Sekarang
       digabung: kategori dinamis, admin bisa tambah sendiri lewat menu
       Kategori, dan produk bisa dicentang lebih dari satu kategori sekaligus
       (mis. "Free Fire" + "Android" bersamaan). -->
  <div class="section-card">
    <h2 class="text-sm font-black text-white mb-3 flex items-center gap-2">
      <iconify-icon icon="mdi:tag-multiple" class="text-red-400 text-lg"></iconify-icon> Kategori
    </h2>
    <div class="flex flex-wrap gap-2" id="categoryCheckboxes">
      <% (settings.categories||[]).forEach(cat => { %>
      <button type="button" class="category-toggle-btn py-2 px-3.5 rounded-xl text-xs font-black border transition-all flex items-center gap-1.5" data-cat="<%= cat %>" onclick="toggleCategory('<%= cat %>')">
        <%= (settings.categoryLabels||{})[cat] || cat %>
      </button>
      <% }) %>
      <% if (!(settings.categories||[]).length) { %>
      <p class="text-[11px] text-zinc-600">Belum ada kategori. Tambah dulu di menu Kategori (Admin Panel → Pengaturan).</p>
      <% } %>
    </div>
    <p class="text-[10px] text-zinc-600 mt-2">Pilih kategori yang berlaku untuk produk ini (bisa lebih dari satu)</p>
  </div>

  <!-- ── ANGKA TERJUAL ── -->
  <div class="section-card">
    <h2 class="text-sm font-black text-white mb-1 flex items-center gap-2">
      <iconify-icon icon="mdi:tag-heart" class="text-red-400 text-lg"></iconify-icon> Tampilan Katalog (Opsional)
    </h2>
    <p class="text-[11px] text-zinc-500 mb-4">Override manual untuk tampilan di halaman katalog. Kosongkan untuk pakai nilai otomatis/asli.</p>
    <div>
      <label class="text-[11px] text-zinc-400 font-bold mb-1 block">Angka "Terjual"</label>
      <input type="text" inputmode="numeric" id="fakeSoldInput" class="hm-input text-sm" placeholder="Otomatis"
        oninput="const n=this.value.replace(/[^0-9]/g,'');this.value=n===''?'':parseInt(n,10).toLocaleString('id-ID');">
    </div>
  </div>

  <!-- ── ULASAN & RATING ── -->
  <div class="section-card">
    <h2 class="text-sm font-black text-white mb-1 flex items-center gap-2">
      <iconify-icon icon="mdi:star" class="text-red-400 text-lg"></iconify-icon> Ulasan & Rating
    </h2>
    <p class="text-[11px] text-zinc-500 mb-4">Tambah ulasan untuk produk ini. Muncul di halaman detail produk berdampingan dengan ulasan asli dari pembeli.</p>

    <!-- Form tambah cepat -->
    <div class="rounded-xl p-3.5 mb-3" style="background:var(--neon-purple-10);border:1px solid var(--neon-purple-20)">
      <div class="grid grid-cols-2 gap-2 mb-2">
        <input type="text" id="testiNameInput" class="hm-input text-xs" placeholder="Nama (mis. Rizky F.)">
        <select id="testiRatingInput" class="hm-input text-xs">
          <option value="5">★★★★★ (5)</option>
          <option value="4">★★★★☆ (4)</option>
          <option value="3">★★★☆☆ (3)</option>
        </select>
      </div>
      <textarea id="testiTextInput" class="hm-input text-xs resize-none mb-2" rows="2" placeholder="Isi ulasan..."></textarea>
      <div class="flex items-center justify-between gap-2">
        <label class="flex items-center gap-1.5 text-[11px] text-zinc-400">
          <input type="checkbox" id="testiVerifiedInput" checked style="accent-color:#dc2626;"> Tandai Verified
        </label>
        <button onclick="addProductTestimonial()" class="py-2 px-3.5 rounded-lg text-[11px] font-bold text-red-400 border border-dashed border-red-500/30 hover:bg-red-500/10 transition-all flex items-center gap-1.5">
          <iconify-icon icon="mdi:plus-circle" class="text-sm"></iconify-icon> Tambah Ulasan
        </button>
      </div>
    </div>

    <!-- List ulasan existing -->
    <div id="productTestiList" class="space-y-2">
      <p class="text-[11px] text-zinc-600 text-center py-3">Memuat ulasan...</p>
    </div>
  </div>

  <!-- ── HARGA PAKET ── -->
  <div class="section-card">
    <h2 class="text-sm font-black text-white mb-1 flex items-center gap-2">
      <iconify-icon icon="mdi:tag-multiple" class="text-red-400 text-lg"></iconify-icon> Harga Paket
    </h2>
    <p class="text-[11px] text-zinc-500 mb-4">Atur durasi (hari atau jam), unit, dan harga untuk setiap paket produk</p>
    <div id="pricingRows" class="space-y-2 mb-3"></div>
    <button onclick="addPricingRow()"
      class="w-full py-2.5 rounded-xl text-xs font-bold text-red-400 border border-dashed border-red-500/30 hover:bg-red-500/10 transition-all flex items-center justify-center gap-1.5">
      <iconify-icon icon="mdi:plus-circle" class="text-sm"></iconify-icon> Tambah Paket
    </button>
    <p class="text-[10px] text-zinc-600 mt-2">Contoh: 7 hari jadi Rp 15.000, 30 hari jadi Rp 50.000, 12 jam jadi Rp 8.000</p>
  </div>

  <!-- ── KEYS / STOK ── -->
  <div class="section-card">
    <h2 class="text-sm font-black text-white mb-1 flex items-center gap-2">
      <iconify-icon icon="mdi:key-variant" class="text-red-400 text-lg"></iconify-icon> Keys & Stok
    </h2>
    <p class="text-[11px] text-zinc-500 mb-4">Stok produk ditentukan dari jumlah keys yang tersedia</p>

    <!-- Info stok per paket -->
    <div id="stockInfo" class="space-y-2 mb-4"></div>

    <!-- Tambah keys -->
    <div class="rounded-xl p-4" style="background:var(--neon-purple-10);border:1px solid var(--neon-purple-20)">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-bold text-red-300">Tambah / Ganti Keys</span>
        <div class="flex gap-1">
          <button id="modeAppend" onclick="setKeysMode('append')"
            class="px-2 py-1 rounded text-[10px] font-bold transition-all">+ Tambah</button>
          <button id="modeReplace" onclick="setKeysMode('replace')"
            class="px-2 py-1 rounded text-[10px] font-bold transition-all"><iconify-icon icon="mdi:refresh" style="vertical-align:-2px;"></iconify-icon> Ganti Semua</button>
        </div>
      </div>
      <textarea id="keysInput" class="hm-input font-mono text-xs resize-none" rows="6"
        placeholder="Masukkan keys, satu per baris&#10;Contoh:&#10;FF7-001=7d&#10;FF30-001=30d&#10;ML12-001=12h"></textarea>
      <input type="file" id="keysFileInput" accept=".txt,.csv" class="hidden" onchange="importKeysFromFile(event)">
      <div class="flex gap-2 mt-2">
        <button type="button" onclick="document.getElementById('keysFileInput').click()"
          class="flex-1 py-2 rounded-lg text-[11px] font-bold text-red-400 border border-dashed border-red-500/30 hover:bg-red-500/10 transition-all flex items-center justify-center gap-1.5">
          <iconify-icon icon="mdi:file-upload-outline" class="text-sm"></iconify-icon> Import dari File (.txt)
        </button>
        <button type="button" onclick="document.getElementById('keysInput').value=''"
          class="px-3 py-2 rounded-lg text-[11px] font-bold text-zinc-500 border border-white/10 hover:text-white hover:bg-white/5 transition-all">
          Bersihkan
        </button>
      </div>
      <p class="text-[10px] text-zinc-600 mt-1.5">
        Format tag durasi: <code class="text-red-400">KEY=7d</code> (7 hari) atau <code class="text-red-400">KEY=12h</code> (12 jam). Key tanpa tag = generic. File di-import otomatis dirapikan: baris kosong &amp; spasi nyasar dibuang, duplikat dibuang.
      </p>
    </div>

    <!-- Preview keys existing -->
    <div id="existingKeys" class="mt-3 hidden">
      <div class="flex items-center justify-between mb-2">
        <span class="text-[11px] text-zinc-500" id="keyCountLabel"></span>
        <div class="flex items-center gap-3">
          <button onclick="exportKeysToFile()" class="text-[10px] text-red-400 hover:text-red-300 transition-colors flex items-center gap-1">
            <iconify-icon icon="mdi:file-download-outline"></iconify-icon> Export
          </button>
          <button onclick="clearAllKeys()" class="text-[10px] text-red-400 hover:text-red-300 transition-colors">Hapus Semua Keys</button>
        </div>
      </div>
      <div id="keyChips" class="max-h-32 overflow-y-auto"></div>
    </div>
  </div>

  <!-- ── TOMBOL SIMPAN ── -->
  <div class="flex gap-3 mt-2">
    <button onclick="saveProduct()"
      class="btn-gaming flex-1 py-3.5 text-sm font-black flex items-center justify-center gap-2">
      <iconify-icon icon="mdi:check-circle" class="text-lg"></iconify-icon> Simpan Perubahan
    </button>
    <button onclick="confirmDelete()"
      class="px-5 py-3.5 rounded-xl bg-red-500/15 text-red-400 border border-red-500/35 hover:bg-red-500/25 font-bold text-sm transition-all flex items-center gap-2">
      <iconify-icon icon="mdi:trash"></iconify-icon>
    </button>
  </div>

</div>
</div>

<script>
let currentProduct = null;
let selectedStatus = 'active';
let keysMode = 'append';
let selectedCategories = [];
let pricingOptions = [];

// ─── Load produk ───
async function loadProduct() {
  const id = new URLSearchParams(location.search).get('id');
  if (!id) { showToast('ID produk tidak ditemukan', 'error'); return; }

  const res = await fetch('/admin/product/' + id);
  const data = await res.json();
  if (!data.success) { showToast(data.message || 'Gagal memuat', 'error'); return; }

  currentProduct = data.data;
  document.getElementById('productNameLabel').textContent = currentProduct.name;

  // Gambar
  const img = currentProduct.image || currentProduct.bannerUrl || '';
  document.getElementById('imgUrlInput').value = img;
  previewImg(img);

  // Deskripsi
  document.getElementById('descriptionInput').value = currentProduct.description || '';

  // Tab Showcase & Information
  document.getElementById('videoUrlInput').value = currentProduct.videoUrl || '';
  document.getElementById('compatibilityInput').value = currentProduct.compatibility || '';
  document.getElementById('featureListInput').value = (currentProduct.featureList || []).join('\n');

  // Channel URL
  document.getElementById('channelUrlInput').value = currentProduct.channelUrl || '';
  document.getElementById('downloadUrlInput').value = currentProduct.downloadUrl || '';

  // Tampilan katalog (opsional)
  document.getElementById('fakeSoldInput').value = (currentProduct.fakeSold != null) ? Number(currentProduct.fakeSold).toLocaleString('id-ID') : '';

  // Ulasan & Rating produk ini
  loadProductTestimonials();

  // Status
  selectedStatus = currentProduct.status || 'active';
  updateStatusBtns();

  // Kategori -- FIX (diminta client 22 Agu 2026): baca dari field baru
  // `categories` (array), dengan fallback ke data lama untuk backward
  // compat -- produk lama mungkin masih punya `category` (string tunggal)
  // atau `platforms` (array Android/iOS/PC hardcode lama), supaya data
  // lama tidak hilang begitu saja saat produk lama pertama kali dibuka
  // di halaman edit yang baru ini.
  if (Array.isArray(currentProduct.categories)) {
    selectedCategories = currentProduct.categories;
  } else if (Array.isArray(currentProduct.platforms) && currentProduct.platforms.length) {
    selectedCategories = currentProduct.platforms;
  } else if (currentProduct.category) {
    selectedCategories = [currentProduct.category];
  } else {
    selectedCategories = [];
  }
  updateCategoryBtns();

  // Pricing Options
  if (currentProduct.pricingOptions && currentProduct.pricingOptions.length > 0) {
    pricingOptions = currentProduct.pricingOptions.map(o => ({
      days: o.days,
      unit: o.unit === 'h' ? 'h' : 'd',
      price: o.price,
      reseller_price: (o.reseller_price !== undefined && o.reseller_price !== null) ? o.reseller_price : null,
      strike_price: (o.strike_price !== undefined && o.strike_price !== null) ? o.strike_price : null,
      dripstoreVariantId: o.dripstoreVariantId || null
    }));
  } else if (currentProduct.items && currentProduct.items.length > 0) {
    // Fallback untuk produk lama yang cuma punya 'items' tanpa 'pricingOptions'.
    // Regex diperlonggar: terima "30 DAYS", "30 HARI", "12 JAM", "30D", dst — asal ada angka di label.
    pricingOptions = currentProduct.items.map((item, idx) => {
      const label = String(item.l || '');
      const m = label.match(/(\d+)\s*(DAYS?|HARI|JAM|THN|TH|TAHUN|YEARS?|YEAR|YR|YRS|D|H)\b/i) || label.match(/(\d+)/);
      let days = m ? parseInt(m[1], 10) : 0;
      const unit = /JAM|\bH\b/i.test(m?.[2] || label) ? 'h' : 'd';
      if (m && /^(THN|TH|TAHUN|YEARS?|YEAR|YR|YRS)$/i.test(m[2] || '')) days *= 365;
      return {
        days: days > 0 ? days : (idx + 1), // kalau tetap gak ketemu, kasih angka dummy biar gak ke-drop & admin bisa perbaiki manual
        unit,
        price: (item.p !== undefined && item.p !== null) ? item.p : 0,
        reseller_price: (item.reseller_price !== undefined && item.reseller_price !== null) ? item.reseller_price : null,
        strike_price: (item.strike_price !== undefined && item.strike_price !== null) ? item.strike_price : null
      };
    });
  } else {
    pricingOptions = [];
  }
  renderPricingRows();

  // Keys + authoritative live stock (provider/local).
  liveStockInfo = null;
  renderKeyInfo();
  setKeysMode('append');
  refreshLiveStockInfo();
}

async function refreshLiveStockInfo() {
  if (!currentProduct?.id) return;
  try {
    const r = await fetch('/api/products/' + encodeURIComponent(currentProduct.id) + '/stock', { cache: 'no-store' });
    if (!r.ok) return;
    const d = await r.json();
    if (!d?.success || !Array.isArray(d.items)) return;
    liveStockInfo = d;
    renderKeyInfo();
  } catch (_) { /* local stock info tetap tampil */ }
}

function previewImg(url) {
  const img = document.getElementById('imgPreview');
  const ph  = document.getElementById('imgPlaceholder');
  if (url && url.trim()) {
    img.src = url.trim();
    img.classList.remove('hidden');
    ph.classList.add('hidden');
    img.onerror = () => { img.classList.add('hidden'); ph.classList.remove('hidden'); };
  } else {
    img.classList.add('hidden');
    ph.classList.remove('hidden');
  }
}

async function uploadBanner(e) {
  const file = e.target.files[0];
  if (!file) return;
  const fd = new FormData();
  fd.append('banner', file);
  const res  = await fetch('/admin/upload-banner', { method: 'POST', body: fd });
  const data = await res.json();
  if (data.success) {
    document.getElementById('imgUrlInput').value = data.bannerUrl;
    previewImg(data.bannerUrl);
    showToast('Gambar berhasil diupload', 'success');
  } else {
    showToast(data.message || 'Gagal upload', 'error');
  }
}

// ─── Status ───
function setStatus(s) {
  selectedStatus = s;
  updateStatusBtns();
