// ─── Render info keys/stok ───
let liveStockInfo = null;

function renderKeyInfo() {
  const p = currentProduct;
  const keys = Array.isArray(p.keys) ? p.keys : [];
  const seenKeys = new Set();
  const usableKeys = keys.map(k => String(k || '').trim()).filter(s => {
    if (!s || /^(?:stok|stock|produk)\s+(?:tidak\s+tersedia|unavailable)\s*:/i.test(s) || seenKeys.has(s)) return false;
    seenKeys.add(s); return true;
  });
  const totalKeys = usableKeys.length;

  // Parsing key format "KEY=7d" / "KEY=12h" (lihat parseKeyDuration di server).
  // Separator "=" (bukan ":") karena key silent cheat ada yang isinya sendiri
  // mengandung ":", bentrok kalau dipakai sebagai separator durasi.
  function parseKeyTag(k) {
    const idx = k.lastIndexOf('=');
    if (idx === -1) return { days: null, unit: null };
    const m = k.slice(idx + 1).trim().toLowerCase().match(/^(\d+)\s*(d|h)?$/);
    if (!m) return { days: null, unit: null };
    return { days: parseInt(m[1]), unit: m[2] || 'd' };
  }

  // Stok per item: satu baris = satu durasi. Sumber authoritative jika tersedia
  // adalah /api/products/:id/stock (local + provider), bukan simbol "Live" tanpa angka.
  const stockHtml = (p.items || []).map((item, itemIdx) => {
    const m = (item.l || '').match(/(\d+)\s+(DAYS?|HARI|JAM|THN|TH|TAHUN|YEARS?|YEAR|YR|YRS)/i);
    let days = m ? parseInt(m[1]) : null;
    let unit = m && /JAM/i.test(m[2]) ? 'h' : 'd';
    if (m && /^(THN|TH|TAHUN|YEARS?|YEAR|YR|YRS)$/i.test(m[2])) days *= 365;
    const remote = Array.isArray(liveStockInfo?.items) ? liveStockInfo.items[itemIdx] : null;
    let localStok = remote ? Number(remote.localStock || 0) : 0;
    let providerStok = remote ? Number(remote.providerStock || 0) : 0;
    let totalStok = remote ? Number(remote.stock || 0) : null;
    let providerKnown = remote ? !!remote.providerKnown : false;
    let providerBacked = remote ? !!remote.providerBacked : false;

    if (!remote) {
      const tagged = usableKeys.filter(k => {
        const t = parseKeyTag(k); return days != null ? t.days === days && t.unit === unit : t.days === null;
      }).length;
      localStok = tagged;
      totalStok = tagged;
      const opt = (p.pricingOptions || [])[itemIdx];
      providerBacked = !!opt?.dripstoreVariantId;
    }

    let right;
    if (providerBacked && providerKnown) {
      right = `Lokal ${localStok} + Provider ${providerStok} = ${Math.max(0,totalStok)} stok`;
    } else if (providerBacked && !providerKnown) {
      right = `Lokal ${localStok} + Provider cek stok`;
    } else {
      right = `${Math.max(0, Number(totalStok || 0))} stok lokal`;
    }
    const color = (!providerKnown && providerBacked && localStok === 0)
      ? 'text-amber-500 border-amber-500/30 bg-amber-500/10'
      : (Number(totalStok || 0) <= 0 ? 'text-red-400 border-red-500/30 bg-red-500/10' : Number(totalStok || 0) < 5 ? 'text-yellow-400 border-yellow-500/30 bg-yellow-500/10' : 'text-emerald-400 border-emerald-500/30 bg-emerald-500/10');
    return `<div class="flex items-center justify-between p-3 rounded-xl border ${color}">
      <span class="text-xs font-bold text-white">${item.l}</span>
      <span class="text-xs font-black">${right}</span>
    </div>`;
  }).join('');
  document.getElementById('stockInfo').innerHTML = stockHtml;

  // Preview keys existing
  const wrap = document.getElementById('existingKeys');
  if (totalKeys > 0) {
    wrap.classList.remove('hidden');
    document.getElementById('keyCountLabel').textContent = `${totalKeys} key tersimpan`;
    const chips = usableKeys.slice(0, 30).map(k => `<span class="key-chip">${k}</span>`).join('');
    document.getElementById('keyChips').innerHTML = chips + (totalKeys > 30 ? `<span class="key-chip text-zinc-500">+${totalKeys - 30} lainnya</span>` : '');
  } else {
    wrap.classList.add('hidden');
  }
}

// ─── Import keys dari file (.txt) ───
// Diminta client 15 Sep 2026: upload file isi key -> otomatis keisi ke
// textarea, DIRAPIKAN dulu (baris kosong dibuang, spasi nyasar di awal/akhir
// tiap baris dipangkas, duplikat dibuang tapi urutan kemunculan pertama
// dipertahankan) sebelum digabung ke isi textarea yang sudah ada.
async function importKeysFromFile(e) {
  const file = e.target.files[0];
  if (!file) return;
  if (file.size > 2 * 1024 * 1024) { // 2MB, cukup lebar buat ribuan baris key
    showToast('File terlalu besar (maks 2MB)', 'error');
    e.target.value = '';
    return;
  }
  try {
    const text = await file.text();
    const rawLines = text.split(/\r\n|\r|\n/);
    const seen = new Set();
    const cleaned = [];
    let dupeCount = 0, emptyCount = 0;
    for (let line of rawLines) {
      line = line.trim();
      if (!line) { emptyCount++; continue; }
      if (seen.has(line)) { dupeCount++; continue; }
      seen.add(line);
      cleaned.push(line);
    }
    if (cleaned.length === 0) {
      showToast('File tidak berisi key yang valid (kosong semua)', 'error');
      e.target.value = '';
      return;
    }
    const textarea = document.getElementById('keysInput');
    const existing = textarea.value.trim();
    textarea.value = existing ? existing + '\n' + cleaned.join('\n') : cleaned.join('\n');
    let msg = `${cleaned.length} key dari file berhasil dimasukkan`;
    const notes = [];
    if (dupeCount > 0) notes.push(`${dupeCount} duplikat dibuang`);
    if (emptyCount > 0) notes.push(`${emptyCount} baris kosong dibuang`);
    if (notes.length) msg += ` (${notes.join(', ')})`;
    showToast(msg, 'success');
  } catch (err) {
    showToast('Gagal membaca file', 'error');
  } finally {
    e.target.value = ''; // reset supaya file yang sama bisa dipilih lagi kalau perlu
  }
}

// ─── Export keys existing ke file (.txt) ───
// Format export SAMA PERSIS dengan format import (satu key per baris,
// termasuk tag durasi KEY=7d/KEY=12h kalau ada) -- supaya file hasil
// export bisa langsung dipakai lagi buat import ke produk lain tanpa
// perlu diedit ulang.
function exportKeysToFile() {
  const keys = (currentProduct && currentProduct.keys) || [];
  if (keys.length === 0) { showToast('Belum ada keys untuk di-export', 'error'); return; }
  const content = keys.join('\n');
  const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  const safeName = (currentProduct.name || 'produk').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  a.href = url;
  a.download = `keys-${safeName || 'produk'}-${keys.length}.txt`;
  document.body.appendChild(a);
  a.click();
  // BUG FIX (audit 19 Sep 2026): sebelumnya a.remove() + URL.revokeObjectURL(url)
  // dipanggil LANGSUNG setelah a.click(), di baris yang sama tanpa jeda. Di
  // banyak browser Android (termasuk WebView/Samsung Internet/Chrome mobile),
  // a.click() cuma MEMICU proses download -- browser belum tentu sudah selesai
  // (atau bahkan belum mulai) benar-benar membaca blob-nya saat baris berikutnya
  // langsung dieksekusi. Kalau URL.revokeObjectURL() keburu jalan duluan sebelum
  // browser sempat baca, blob URL-nya sudah "mati" pas mau dipakai -> muncul
  // error "File Anda tidak dapat diakses" / ERR_FILE_NOT_FOUND pada blob:...
  // persis yang dilaporkan Mul. Fix: kasih jeda (setTimeout) sebelum cleanup,
  // supaya browser punya waktu benar-benar mulai proses simpan filenya dulu.
  setTimeout(() => {
    a.remove();
    URL.revokeObjectURL(url);
  }, 1000);
  showToast(`${keys.length} key berhasil di-export`, 'success');
}

async function clearAllKeys() {
  if (!confirm('Hapus semua keys? Stok akan menjadi 0.')) return;
  const res = await fetch(`/admin/product/keys/${currentProduct.id}`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ keys: '', mode: 'replace' })
  });
  const data = await res.json();
  if (data.success) {
    currentProduct.keys = [];
    renderKeyInfo();
    showToast('Semua keys dihapus', 'success');
  }
}

// ─── Simpan ───
async function saveProduct() {
  const imgUrl  = document.getElementById('imgUrlInput').value.trim();
  const keysRaw = document.getElementById('keysInput').value.trim();
  const description = document.getElementById('descriptionInput').value.trim();
  const videoUrl = document.getElementById('videoUrlInput').value.trim();
  const compatibility = document.getElementById('compatibilityInput').value.trim();
  const featureList = document.getElementById('featureListInput').value.trim();
  const channelUrl = document.getElementById('channelUrlInput').value.trim();
  const downloadUrl = document.getElementById('downloadUrlInput').value.trim();
  const fakeSoldRaw = document.getElementById('fakeSoldInput').value.replace(/[^0-9]/g,'');

  // Validasi harga
  const validPricing = pricingOptions.filter(o => o.days > 0);
  if (validPricing.length === 0) {
    showToast('Tambahkan minimal 1 paket harga', 'error');
    return;
  }

  // Cegah harga 0 tersimpan tanpa sengaja — minta konfirmasi eksplisit dulu.
  const zeroPriceRows = validPricing.filter(o => !o.price || o.price <= 0);
  if (zeroPriceRows.length > 0) {
    const days = zeroPriceRows.map(o => o.days + (o.unit === 'h' ? ' jam' : ' hari')).join(', ');
    if (!confirm(`Paket ${days} harganya Rp 0. Lanjut simpan dengan harga Rp 0?\n\nKalau ini tidak sengaja, klik Batal lalu isi harganya dulu.`)) {
      return;
    }
  }

  // Cegah duplikat (hari/jam + unit) (mis. 2 baris sama-sama "30 hari" dengan harga beda) —
  // baris belakangan akan menang dan bisa bikin bingung, jadi tolak dulu di sini.
  // Dicek berpasangan (days, unit) supaya "30 hari" dan "30 jam" TIDAK dianggap duplikat.
  const seenDays = new Set();
  const dupeDays = new Set();
  for (const o of validPricing) {
    const key = `${o.days}${o.unit||'d'}`;
    if (seenDays.has(key)) dupeDays.add(`${o.days} ${o.unit==='h'?'jam':'hari'}`);
    seenDays.add(key);
  }
  if (dupeDays.size > 0) {
    showToast(`Ada durasi ganda: ${[...dupeDays].join(', ')}. Hapus salah satu baris dulu.`, 'error');
    return;
  }

  // Validasi harga coret per-durasi: kalau diisi, harus lebih besar dari harga jual paket itu.
  const invalidStrike = validPricing.filter(o => o.strike_price && o.strike_price <= o.price);
  if (invalidStrike.length > 0) {
    showToast('Harga coret harus lebih besar dari harga jual pada paket yang sama. Cek lagi paketnya.', 'error');
    return;
  }

  const res = await fetch(`/admin/product/${currentProduct.id}`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      bannerUrl: imgUrl,
      status: selectedStatus,
      keys: keysRaw,
      keysMode,
      categories: selectedCategories,
      pricingOptions: validPricing,
      description,
      videoUrl,
      compatibility,
      featureList,
      channelUrl,
      downloadUrl,
      fakeSold: fakeSoldRaw === '' ? '' : fakeSoldRaw
    })
  });
  const data = await res.json();
  if (data.success) {
    showToast('Produk berhasil disimpan!', 'success');
    currentProduct = data.data;
    document.getElementById('keysInput').value = '';
    renderKeyInfo();
  } else {
    showToast(data.message || 'Gagal menyimpan', 'error');
  }
}

async function confirmDelete() {
