          </div>
          <div class="flex items-center gap-1 flex-shrink-0">
            ${t.verified ? '<span class="text-[9px] font-black px-1.5 py-0.5 rounded" style="background:rgba(16,185,129,.15);color:#34d399;border:1px solid rgba(16,185,129,.3)">VERIFIED</span>' : '<span class="text-[9px] font-black px-1.5 py-0.5 rounded" style="background:rgba(234,179,8,.15);color:#fbbf24;border:1px solid rgba(234,179,8,.3)">PENDING</span>'}
          </div>
        </div>
        <p class="text-[11px] text-zinc-400 leading-relaxed mb-2">"${short}"</p>
        ${isGlobalFake
          ? '<p class="text-[10px] text-zinc-600">Ulasan bawaan sistem — kelola dari Admin Panel &gt; Testimoni</p>'
          : `<div class="flex gap-1.5">
              <button onclick="toggleProductTestimonialVerified('${t.id}')" class="py-1 px-2 text-[10px] rounded-lg font-bold transition-all" style="${t.verified ? 'background:rgba(16,185,129,.1);color:#34d399;border:1px solid rgba(16,185,129,.25);' : 'background:rgba(234,179,8,.1);color:#fbbf24;border:1px solid rgba(234,179,8,.25);'}">${t.verified ? 'Batalkan Verified' : 'Tandai Verified'}</button>
              <button onclick="deleteProductTestimonial('${t.id}')" class="py-1 px-2 text-[10px] rounded-lg font-bold text-red-400 border border-red-500/25 hover:bg-red-500/10 transition-all"><iconify-icon icon="mdi:trash-can"></iconify-icon> Hapus</button>
            </div>`
        }
      </div>`;
    }).join('');
  } catch (err) {
    el.innerHTML = '<p class="text-[11px] text-red-400 text-center py-3">Gagal memuat ulasan</p>';
  }
}

async function addProductTestimonial() {
  const name = document.getElementById('testiNameInput').value.trim();
  const rating = document.getElementById('testiRatingInput').value;
  const text = document.getElementById('testiTextInput').value.trim();
  const verified = document.getElementById('testiVerifiedInput').checked;

  if (!name || !text) { showToast('Nama dan isi ulasan wajib diisi', 'error'); return; }

  const res = await fetch('/admin/testimonial/add', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ name, rating, text, product: currentProduct.id, verified, featured: false })
  });
  const data = await res.json();
  if (data.success) {
    showToast('Ulasan ditambahkan', 'success');
    document.getElementById('testiNameInput').value = '';
    document.getElementById('testiTextInput').value = '';
    document.getElementById('testiVerifiedInput').checked = true;
    loadProductTestimonials();
  } else {
    showToast(data.message || 'Gagal menambah ulasan', 'error');
  }
}

async function deleteProductTestimonial(id) {
  if (!confirm('Hapus ulasan ini?')) return;
  const res = await fetch(`/admin/testimonial/delete/${id}`, { method: 'POST' });
  const data = await res.json();
  if (data.success) { showToast('Ulasan dihapus', 'success'); loadProductTestimonials(); }
  else showToast(data.message || 'Gagal menghapus', 'error');
}

async function toggleProductTestimonialVerified(id) {
  const res = await fetch(`/admin/testimonial/toggle-verified/${id}`, { method: 'POST' });
  const data = await res.json();
  if (data.success) loadProductTestimonials();
  else showToast(data.message || 'Gagal update status', 'error');
}

function showToast(msg, type='info') {
  let c = document.getElementById('toast-container');
  if (!c) { c = document.createElement('div'); c.id = 'toast-container'; document.body.appendChild(c); }
  const t = document.createElement('div');
  const cls = { success:'bg-emerald-500/20 border-emerald-500/40 text-emerald-300', error:'bg-red-500/20 border-red-500/40 text-red-300', info:'bg-zinc-500/20 border-zinc-500/40 text-red-300' };
  t.className = `fixed top-4 right-4 z-[99999] px-4 py-3 rounded-xl border backdrop-blur-sm text-sm font-bold ${cls[type]||cls.info} translate-x-0 transition-all`;
  t.textContent = msg;
  c.appendChild(t);
  setTimeout(() => { t.style.opacity='0'; setTimeout(() => t.remove(), 300); }, 3000);
}

document.addEventListener('DOMContentLoaded', loadProduct);
</script>
