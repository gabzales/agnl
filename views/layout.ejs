<!DOCTYPE html>
<html lang="id">
<head>
    <!-- DARK MODE: dijalankan sinkron paling awal (sebelum CSS/body
         dirender) supaya kalau user sudah pernah pilih dark mode,
         class "dark" langsung terpasang sebelum halaman sempat kelihatan
         putih dulu (mencegah "flash" putih sekilas tiap ganti halaman). -->
    <script>
      try {
        if (localStorage.getItem('fz-theme') === 'dark') {
          document.documentElement.classList.add('dark');
        }
      } catch (e) {}
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' — ' : '' %><%= settings?.siteName || 'AGHA NL' %></title>
    <meta name="description" content="<%= typeof pageDescription !== 'undefined' && pageDescription ? pageDescription : (settings?.about || 'AGHA NL DIGITAL STORE - Platform Digital Terpercaya') %>">
    <!-- SEO (diminta client 22 Agu 2026, target keyword "topup mod ff" dkk) -->
    <meta name="keywords" content="<%= settings?.seoKeywords || 'topup mod ff, key mod ff, cheat free fire, mod menu ff, topup mod game' %>">
    <meta name="robots" content="<%= typeof noIndex !== 'undefined' && noIndex ? 'noindex, nofollow' : 'index, follow' %>">
    <link rel="canonical" href="<%= siteUrl %><%= typeof canonicalPath !== 'undefined' ? canonicalPath : '' %>">
    <!-- Open Graph (preview link WhatsApp/Telegram/Facebook) -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="<%= settings?.siteName || 'AGHA NL' %>">
    <meta property="og:title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle + ' — ' : '' %><%= settings?.siteName || 'AGHA NL' %>">
    <meta property="og:description" content="<%= typeof pageDescription !== 'undefined' && pageDescription ? pageDescription : (settings?.about || 'AGHA NL DIGITAL STORE - Platform Digital Terpercaya') %>">
    <meta property="og:image" content="<%= settings?.logoUrl ? (settings.logoUrl.startsWith('http') ? settings.logoUrl : siteUrl + settings.logoUrl) : siteUrl + '/uploads/logo-main.png' %>">
    <meta property="og:url" content="<%= siteUrl %><%= typeof canonicalPath !== 'undefined' ? canonicalPath : '' %>">
    <meta property="og:locale" content="id_ID">
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle + ' — ' : '' %><%= settings?.siteName || 'AGHA NL' %>">
    <meta name="twitter:description" content="<%= typeof pageDescription !== 'undefined' && pageDescription ? pageDescription : (settings?.about || 'AGHA NL DIGITAL STORE - Platform Digital Terpercaya') %>">
    <meta name="twitter:image" content="<%= settings?.logoUrl ? (settings.logoUrl.startsWith('http') ? settings.logoUrl : siteUrl + settings.logoUrl) : siteUrl + '/uploads/logo-main.png' %>">
    <meta name="theme-color" content="#ffffff">
    <link rel="icon" type="image/png" href="<%= settings?.logoUrl || '/uploads/logo-main.png' %>">
    <link rel="apple-touch-icon" href="<%= settings?.logoUrl || '/uploads/logo-main.png' %>">
    <!-- FIX PERFORMA (diminta client 22 Agu 2026): Tailwind Play CDN diganti
         Tailwind CLI (file CSS statis di-build sekali, lihat tailwind.config.js
         & package.json script "build:css"). CDN lama itu JIT compiler yang
         jalan penuh di browser (scan seluruh DOM + generate CSS real-time
         tiap halaman) -- berat khususnya di HP Android low-end, dan menurut
         dokumentasi resmi Tailwind sendiri "not the best choice for
         production". File statis ini ~30KB (gzip lebih kecil lagi),
         dibanding CDN yang kirim ratusan KB JS + runtime compile. -->
    <link rel="stylesheet" href="/css/tailwind.css">
    <script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js" defer></script>
    <link rel="preconnect" href="https://code.iconify.design">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        /* ═══════════════════════════════
           AGHA NL — Clean Minimal UI
           Redesign 22 Agu 2026: background PUTIH, aksen MERAH solid,
           flat (tanpa gradient/neon glow) -- diminta client, referensi
           mallstore.id/vip-kingstore.com. Variable lama (--bg-main dkk)
           DIPERTAHANKAN NAMANYA supaya semua halaman lain yang masih
           pakai var(--bg-main) dst otomatis ikut berubah tanpa perlu
           di-cari-ganti satu-satu di setiap file.
           ═══════════════════════════════ */
        :root {
            --bg-main:    #ffffff;
            --bg-section: #f8f8f9;
            --bg-card:    #ffffff;
            --bg-hover:   #f4f4f5;
            --border:     #ececee;
            --border-md:  #e0e0e3;
            --blue:       #dc2626;
            --blue-dim:   rgba(220,38,38,0.08);
            --blue-dark:  #b91c1c;
            --green:      #22c55e;
            --green-dim:  rgba(34,197,94,0.1);
            --red:        #ef4444;
            --red-dim:    rgba(239,68,68,0.1);
            --amber:      #f59e0b;
            --text-1:     #18181b;
            --text-2:     #71717a;
            --text-3:     #a1a1aa;
            --brand-wa:   #25d366;
        }

        /* ═══════════════════════════════
           DARK MODE (23 Agu 2026, direvisi 24 Agu 2026) — tahap 1:
           infrastruktur inti. Override variable dasar yang sama dipakai
           di seluruh halaman (lihat komentar di atas soal var(--bg-main)
           dst). Homepage dan komponen layout bersama (navbar, menu
           drawer, modal) sudah konsisten pakai variable ini jadi
           otomatis ikut berubah. HALAMAN LAIN (admin, dashboard, buy,
           leaderboard, dll) masih punya banyak warna HARDCODE yang
           belum diaudit -- itu belum dijamin terlihat benar dalam mode
           gelap sampai menyusul diperbaiki satu per satu. Aktif lewat
           class "dark" di <html>, di-toggle dari menu hamburger dan
           disimpan ke localStorage (lihat script di bawah) supaya
           pilihan bertahan antar kunjungan/halaman.

           REVISI 24 Agu 2026: client minta background "Mode Gelap"
           BUKAN hitam pekat, melainkan putih susu/putih redup (#f4f4f5,
           dikonfirmasi dari sample warna yang dikirim client). Jadi
           walau namanya masih "Mode Gelap" di UI (nama toggle tidak
           diubah), warna sebenarnya adalah varian off-white yang lebih
           redup dari mode default (#ffffff) -- teks disesuaikan tetap
           GELAP (bukan terang) supaya kontras terhadap background
           terang ini. */
        html.dark {
            --bg-main:    #f4f4f5;
            --bg-section: #e4e4e7;
            --bg-card:    #f4f4f5;
            --bg-hover:   #e4e4e7;
            --border:     #d4d4d8;
            --border-md:  #a1a1aa;
            --text-1:     #18181b;
            --text-2:     #52525b;
            --text-3:     #71717a;
        }
        html.dark body { background: var(--bg-main); }

        *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
        html {
            height:100%;
            width:100%;
            max-width:100%;
            overflow-x:hidden;
            background:#ffffff;
        }
        body {
            font-family:'Inter',sans-serif;
            background:#ffffff;
            color:var(--text-1);
            min-height:100dvh;
            width:100%;
            max-width:100%;
            position:relative;
            -webkit-font-smoothing:antialiased;
            overflow-x:hidden;
        }
        body.no-scroll { overflow:hidden; }

        ::-webkit-scrollbar { width:4px; }
        ::-webkit-scrollbar-track { background:#f4f4f5; }
        ::-webkit-scrollbar-thumb { background:#d4d4d8; border-radius:4px; }

        @keyframes fadeIn   { from{opacity:0} to{opacity:1} }
        @keyframes slideUp  { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }
        @keyframes slideRight { from{opacity:0;transform:translateX(100%)} to{opacity:1;transform:translateX(0)} }
        @keyframes slideBottom { from{transform:translateY(100%)} to{transform:translateY(0)} }
        @keyframes spin     { to{transform:rotate(360deg)} }
        @keyframes marquee  { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }
        @keyframes toastIn  { from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:translateY(0)} }

        .animate-spin   { animation:spin 1s linear infinite; }
        .fade-in-up     { animation:slideUp .3s ease both; }

        /* ── glass utility ── */
        .glass {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 10px;
        }
        .glass-strong {
            background: var(--bg-card);
            border: 1px solid var(--border-md);
            border-radius: 12px;
        }

        /* ── Cards ── */
        .card {
            background:var(--bg-card);
            border:1px solid var(--border);
            border-radius:12px;
        }
        .card-hover {
            transition:border-color .2s, background .2s;
            cursor:pointer;
        }
        .card-hover:hover {
            border-color:var(--border-md);
            background:var(--bg-hover);
        }
        .card-hover:active { opacity:.85; }

        /* ── Buttons ── */
        .btn {
            display:inline-flex; align-items:center; justify-content:center;
            gap:6px; font-weight:600; font-size:13px;
            border-radius:8px; cursor:pointer;
            transition:opacity .15s, transform .1s;
            border:none; text-decoration:none;
        }
        .btn:active { transform:scale(.97); }
        .btn-primary {
            background:var(--blue);
            color:#fff;
            padding:10px 18px;
        }
        .btn-primary:hover { opacity:.88; }
        .btn-outline {
            background:transparent;
            border:1px solid var(--border-md);
            color:var(--text-2);
            padding:9px 16px;
        }
        .btn-outline:hover { border-color:var(--blue); color:var(--text-1); }
        .btn-green  { background:var(--green); color:#fff; padding:10px 18px; }
        .btn-green:hover { opacity:.88; }
        .btn-red    { background:var(--red);   color:#fff; padding:10px 18px; }
        .btn-red:hover   { opacity:.88; }
        .btn-ghost {
            background:#f4f4f5;
            border:1px solid var(--border);
            color:var(--text-2);
            padding:9px 14px;
        }
        .btn-ghost:hover { background:#ececee; }

        /* ── Inputs ── */
        .hm-input, .form-input {
            width:100%; padding:10px 14px;
            border-radius:8px;
            background:var(--bg-section);
            border:1px solid var(--border-md);
            color:var(--text-1); font-size:13px;
            font-family:'Inter',sans-serif;
            transition:border-color .15s;
        }
        .hm-input:focus, .form-input:focus {
            outline:none;
            border-color:rgba(239,68,68,.5);
            background:rgba(239,68,68,.05);
        }
        .hm-input::placeholder, .form-input::placeholder { color:var(--text-3); }

        /* ── Status badges ── */
        .status-badge {
            display:inline-flex; align-items:center; gap:4px;
            padding:3px 10px; border-radius:6px;
            font-size:10px; font-weight:700;
            text-transform:uppercase; letter-spacing:.4px;
        }
        .status-pending  { background:rgba(245,158,11,.12); color:#fbbf24; border:1px solid rgba(245,158,11,.2); }
        .status-done     { background:var(--green-dim);     color:#4ade80; border:1px solid rgba(34,197,94,.2); }
        .status-cancelled{ background:var(--red-dim);       color:#f87171; border:1px solid rgba(239,68,68,.2); }

        /* ── Product/game card ── */
        .product-card { transition:border-color .2s, opacity .15s; }
        .product-card:hover  { border-color:var(--border-md) !important; }
        .product-card:active { opacity:.8; }

        /* ── Scrollable rows ── */
        .h-scroll {
            display:flex; gap:10px;
            overflow-x:auto; scroll-snap-type:x mandatory;
            -webkit-overflow-scrolling:touch;
            scrollbar-width:none; padding-bottom:4px;
        }
        .h-scroll::-webkit-scrollbar { display:none; }
        .h-scroll-item { scroll-snap-align:start; flex-shrink:0; }

        /* ── Filter pills ── */
        .filter-pill {
            padding:6px 14px; border-radius:20px;
            border:1px solid var(--border);
            background:transparent; color:var(--text-2);
            font-size:12px; font-weight:500;
            white-space:nowrap; cursor:pointer;
            transition:all .15s;
        }
        .filter-pill.active, .filter-pill:hover {
            background:var(--blue);
            border-color:var(--blue);
            color:#fff;
        }
        .filter-pill:active { opacity:.8; }

        /* ── Section label ── */
        .section-label {
            font-size:11px; font-weight:700;
            letter-spacing:.06em; text-transform:uppercase;
            color:var(--text-3);
        }

        /* ── Marquee ── */
        .marquee-track { animation:marquee 18s linear infinite; }

        /* ── Modals ── */
        .modal-overlay {
            position:fixed; inset:0;
            background:rgba(0,0,0,.75);
            z-index:9000;
            display:flex; align-items:flex-end;
        }
        .modal-sheet {
            width:100%; background:var(--bg-card);
            border-top:1px solid var(--border);
            border-radius:20px 20px 0 0;
            max-height:92dvh; overflow-y:auto;
            animation:slideBottom .22s ease both;
        }
        .modal-sheet::-webkit-scrollbar { width:3px; }
        .modal-sheet::-webkit-scrollbar-thumb { background:#3f3f46; }

        /* ── Side drawer ── */
        .side-drawer {
            position:absolute; right:0; top:0; bottom:0;
            width:280px; background:var(--bg-card);
            border-left:1px solid var(--border);
            overflow-y:auto;
            animation:slideRight .22s ease both;
        }

        /* ── Dark mode toggle switch (polos, BUKAN icon matahari/bulan,
             diminta client 23 Agu 2026) ── */
        .dark-toggle-switch { position:relative; display:inline-block; width:38px; height:22px; flex-shrink:0; }
        .dark-toggle-switch input { opacity:0; width:0; height:0; }
        .dark-toggle-slider {
            position:absolute; cursor:pointer; inset:0;
            background:var(--border-md); border-radius:999px;
            transition:.2s;
        }
        .dark-toggle-slider::before {
            content:""; position:absolute; height:16px; width:16px;
            left:3px; bottom:3px; background:#fff; border-radius:50%;
            transition:.2s; box-shadow:0 1px 2px rgba(0,0,0,.2);
        }
        .dark-toggle-switch input:checked + .dark-toggle-slider { background:var(--blue); }
        .dark-toggle-switch input:checked + .dark-toggle-slider::before { transform:translateX(16px); }

        /* ── Payment modal ── */
        #paymentModal { position:fixed !important; z-index:99999 !important; }

        /* ── FOOTER / SOCIAL ICON ALIGNMENT FIX ── */
        footer a[aria-label],
        footer .social-icon,
        footer .social-link,
        footer .footer-social a,
        .footer-social a {
            display:inline-flex !important;
            align-items:center !important;
            justify-content:center !important;
            vertical-align:middle !important;
            line-height:0 !important;
            padding:0 !important;
        }

        footer a[aria-label] iconify-icon,
        footer .social-icon iconify-icon,
        footer .social-link iconify-icon,
        footer .footer-social iconify-icon,
        .footer-social iconify-icon {
            display:block !important;
            line-height:1 !important;
            margin:0 !important;
            transform:none !important;
        }

        /* Any circular social button keeps the glyph perfectly centered. */
        .social-icon, .social-link {
            box-sizing:border-box !important;
        }

        /* ── PAYMENT LOGO CARDS ── */
        .payment-logo-list {
            display:flex !important;
            flex-wrap:wrap !important;
            align-items:center !important;
            gap:10px !important;
            margin-top:12px !important;
        }

        .payment-logo-card {
            width:108px !important;
            height:48px !important;
            min-width:108px !important;
            border:1px solid rgba(220,38,38,.28) !important;
            border-radius:12px !important;
            background:#0b0b0b !important;
            display:inline-flex !important;
            align-items:center !important;
            justify-content:center !important;
            padding:7px 12px !important;
            overflow:hidden !important;
            box-sizing:border-box !important;
            text-decoration:none !important;
            transition:border-color .15s ease, transform .15s ease, background .15s ease !important;
        }

        .payment-logo-card:hover {
            border-color:rgba(220,38,38,.65) !important;
            background:#111 !important;
            transform:translateY(-1px);
        }

        .payment-logo-card img {
            display:block !important;
            width:100% !important;
            height:100% !important;
            max-width:84px !important;
            max-height:34px !important;
            object-fit:contain !important;
            margin:0 auto !important;
        }

        .payment-logo-card--bank {
            color:#d4d4d8 !important;
            font-size:11px !important;
            font-weight:700 !important;
            letter-spacing:.01em !important;
            text-align:center !important;
        }

        .payment-logo-card--bank iconify-icon {
            font-size:18px !important;
            margin-right:6px !important;
            line-height:1 !important;
        }

        @media (max-width:520px) {
            .payment-logo-list { gap:8px !important; }
            .payment-logo-card {
                width:calc(50% - 4px) !important;
                min-width:0 !important;
            }
        }

        /* ── Toast ── */
        #toast-container {
            position:fixed; bottom:20px;
            left:12px; right:12px;
            z-index:9500;
            display:flex; flex-direction:column-reverse; gap:6px;
            pointer-events:none;
        }
        #toast-container > * { pointer-events:auto; }
        .toast {
            display:flex; align-items:center; gap:10px;
            padding:11px 14px; border-radius:10px;
            border:1px solid var(--border-md);
            background:var(--bg-hover);
            font-size:12px; color:var(--text-1);
            animation:toastIn .2s ease both;
            max-width:100%;
        }

        /* ── Purchase notif ── */
        #purchase-notif-container {
            position:fixed; bottom:20px; left:12px;
            z-index:9200;
            display:flex; flex-direction:column; gap:8px;
            pointer-events:none;
        }
        .purchase-notif {
            display:flex; align-items:center; gap:10px;
            padding:10px 14px; border-radius:12px;
            background:var(--bg-hover);
            border:1px solid var(--border-md);
            animation:toastIn .3s ease both;
            max-width:270px;
        }
        .purchase-notif-avatar {
            width:34px; height:34px; border-radius:8px;
            flex-shrink:0; overflow:hidden;
            display:flex; align-items:center; justify-content:center;
            font-weight:800; font-size:13px; color:#fff;
        }
        .purchase-notif-name  { font-size:11px; font-weight:700; color:var(--text-1); }
        .purchase-notif-product { font-size:10px; color:var(--text-2); }
        .purchase-notif-price { font-size:10px; font-weight:700; color:var(--green); white-space:nowrap; }

        /* ── Avatar ── */
        .avatar-wrap { position:relative; cursor:pointer; }
        .avatar-wrap:hover .avatar-overlay { opacity:1; }
        .avatar-overlay {
            position:absolute; inset:0; border-radius:50%;
            background:rgba(0,0,0,.5);
            display:flex; align-items:center; justify-content:center;
            opacity:0; transition:opacity .2s;
        }

        /* ── Profile photo ── */
        .profile-photo-container {
            width:56px; height:56px; border-radius:50%;
            overflow:hidden; flex-shrink:0;
            border:2px solid var(--border-md);
        }
        .profile-photo-container img { width:100%; height:100%; object-fit:cover; }
        .profile-photo-initial {
            width:100%; height:100%;
            background:var(--blue);
            display:flex; align-items:center; justify-content:center;
            font-weight:800; font-size:20px; color:#fff;
        }

        /* ── Misc ── */
        .shimmer-text { color:var(--blue); }
        .neon-text    { color:var(--blue); }
        .neon-card    { background:var(--bg-card); border:1px solid var(--border); border-radius:12px; }
        .buy-btn      { transition:opacity .15s; cursor:pointer; }
        .buy-btn:hover { opacity:.85; }
        .buy-btn:active { opacity:.7; transform:scale(.97); }
        .btn-gaming {
            display:flex; align-items:center; justify-content:center; gap:6px;
            background:var(--blue); color:#fff;
            font-weight:700; border-radius:8px;
            cursor:pointer; border:none;
            transition:opacity .15s;
        }
        .btn-gaming:hover  { opacity:.88; }
        .btn-gaming:active { opacity:.7; transform:scale(.97); }
        .cat-btn {
            padding:6px 14px; border-radius:20px;
            border:1px solid var(--border);
            background:transparent; color:var(--text-2);
            font-size:12px; font-weight:500;
            cursor:pointer; transition:all .15s;
        }
        .cat-btn.active, .cat-btn:hover {
            background:var(--blue); border-color:var(--blue); color:#fff;
        }
        .popular-scroll { display:flex; gap:10px; overflow-x:auto; scroll-snap-type:x mandatory; -webkit-overflow-scrolling:touch; scrollbar-width:none; padding-bottom:4px; }
        .popular-scroll::-webkit-scrollbar { display:none; }
        .popular-card { min-width:180px; max-width:180px; scroll-snap-align:start; flex-shrink:0; }
        
        .popular-scroll-wrapper { position:relative; }
        .filter-scroll { scrollbar-width:none; }
        .filter-scroll::-webkit-scrollbar { display:none; }
        .filter-sticky-left { position:sticky; left:0; z-index:10; flex-shrink:0; background:var(--bg-main); padding-right:6px; display:flex; }
        .prod-filter { transition:all .15s; }
        .testi-card { background:var(--bg-card); border:1px solid var(--border); border-radius:12px; transition:border-color .2s; }
        .testi-card:hover { border-color:var(--border-md); }
        .trust-badge { transition:border-color .2s; }
        .trust-badge:hover { border-color:var(--border-md) !important; }
        .badge-tag { font-size:7px; letter-spacing:.04em; font-weight:800; padding:2px 6px; border-radius:4px; line-height:1.3; text-transform:uppercase; }
        .platform-label { font-size:7px; letter-spacing:.04em; font-weight:700; padding:2px 5px; border-radius:3px; line-height:1.3; background:rgba(239,68,68,.15); color:#fca5a5; border:1px solid rgba(239,68,68,.25); }
        .hm-logo::before { display:none; }
        .hm-logo-img { display:block; flex-shrink:0; }
        body::before, body::after { display:none; }
    </style>

    <!-- Dynamic Theme from DB -->
    <style>
        :root {
            --neon-purple: <%= settings?.theme?.primaryColor || '#dc2626' %>;
            --neon-violet: <%= settings?.theme?.secondaryColor || '#7b2cbf' %>;
            --accent-color:<%= settings?.theme?.accentColor || '#a3123a' %>;
            <%
            /* CATATAN (fix bug 14 Sep 2026): DULU ada baris --bg-dark dan
               --bg-card di sini yang di-set dari settings.theme.backgroundColor
               / cardBackground. --bg-card adalah nama variable yang SAMA
               dipakai di HAMPIR SEMUA halaman (admin-login, login, register,
               buy, reseller, leaderboard, invoice, dashboard, dll) untuk card
               putih/terang berpasangan dengan --text-1 (teks gelap). Begitu
               settings.theme.cardBackground diisi warna gelap (buat tema toko
               AGHA NL), --bg-card ikut jadi gelap di SEMUA halaman itu juga --
               padahal teksnya (--text-1) tetap gelap juga, jadi kebaca nyaris
               tak kelihatan (bug kontras yang dilaporkan client di admin-login).
               Warna gelap khusus tema AGHA NL sekarang HANYA dipakai di
               home.ejs lewat variable terpisah (--fz-bg/--fz-bg-soft), jadi
               tidak nabrak variable global ini lagi. */
            %>
            --glow-color:  <%= hexToRgba(settings?.theme?.primaryColor || '#dc2626', 0.1) %>;
            /* Varian transparan dari warna tema utama, dipakai untuk
               background/border tipis (badge, tombol akun navbar, dll) yang
               dulunya hardcode rgba(220,38,38,...) -- sekarang ikut warna
               tema custom admin (settings.theme.primaryColor). */
            --neon-purple-10: <%= hexToRgba(settings?.theme?.primaryColor || '#dc2626', 0.1) %>;
            --neon-purple-12: <%= hexToRgba(settings?.theme?.primaryColor || '#dc2626', 0.12) %>;
            --neon-purple-18: <%= hexToRgba(settings?.theme?.primaryColor || '#dc2626', 0.18) %>;
            --neon-purple-20: <%= hexToRgba(settings?.theme?.primaryColor || '#dc2626', 0.2) %>;
            --neon-purple-25: <%= hexToRgba(settings?.theme?.primaryColor || '#dc2626', 0.25) %>;
            --neon-purple-35: <%= hexToRgba(settings?.theme?.primaryColor || '#dc2626', 0.35) %>;
            /* Card produk katalog (referensi mallstore.id, diminta client 22
               Agu 2026): background PUTIH terang, bukan gelap seperti
               --bg-card di atas -- warna brand/tema (--neon-purple) dipakai
               sebagai AKSEN saja (harga, border, tombol utama), bukan
               background penuh. */
            --catalog-card-bg: #ffffff;
            --catalog-card-text: #18181b;
            --catalog-card-text-muted: #71717a;
            --catalog-card-border: <%= hexToRgba(settings?.theme?.primaryColor || '#dc2626', 0.1) %>;
        }
    </style>
</head>
<body class="font-inter">
    <div id="toast-container"></div>
    <div id="purchase-notif-container"></div>

    <%- body %>

    <!-- ══ SEARCH PANEL ══ -->
    <div id="search-panel" class="fixed inset-0 flex-col" style="display:none;background:var(--bg-main);z-index:8000;">
        <div class="flex items-center gap-3 p-4 border-b" style="border-color:var(--border);">
            <button onclick="closeSearch()" class="w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0" style="background:#f4f4f5;border:1px solid var(--border);">
                <iconify-icon icon="mdi:arrow-left" style="color:var(--text-2);font-size:18px;"></iconify-icon>
            </button>
            <div class="flex-1 relative">
                <iconify-icon icon="mdi:magnify" class="absolute left-3 top-1/2 -translate-y-1/2" style="color:var(--text-3);font-size:16px;"></iconify-icon>
                <input type="text" id="searchInput" placeholder="Cari produk..." class="hm-input pl-9" oninput="doSearch(this.value)">
            </div>
        </div>
        <div id="searchResults" class="flex-1 overflow-y-auto p-4">
            <div class="text-center py-16" style="color:var(--text-3);">
                <iconify-icon icon="mdi:magnify" style="font-size:40px;" class="block mb-2"></iconify-icon>
                <p class="text-sm">Ketik untuk mencari produk...</p>
            </div>
        </div>
    </div>

    <!-- ══ CART PANEL ══ -->
    <div id="cart-panel" class="fixed inset-0" style="display:none;z-index:8000;">
        <div id="cart-panel-overlay" onclick="closeCart()" class="absolute inset-0" style="background:rgba(0,0,0,.7);"></div>
        <div id="cart-panel-content" class="modal-sheet absolute bottom-0 left-0 right-0">
            <div class="flex items-center justify-between p-4 sticky top-0" style="background:var(--bg-card);border-bottom:1px solid var(--border);">
                <h3 class="font-bold text-sm" style="color:var(--text-1);">Keranjang</h3>
                <button onclick="closeCart()" class="w-8 h-8 rounded-lg flex items-center justify-center" style="background:#f4f4f5;border:1px solid var(--border);">
                    <iconify-icon icon="mdi:close" style="color:var(--text-2);"></iconify-icon>
                </button>
            </div>
            <div id="cartItems" class="p-4 space-y-3"></div>
        </div>
    </div>

    <!-- ══ TRACK PANEL ══ -->
    <div id="track-panel" class="fixed inset-0 hidden" style="z-index:8000;">
        <div class="absolute inset-0" style="background:rgba(0,0,0,.7);" onclick="closeTrack()"></div>
        <div class="modal-sheet absolute bottom-0 left-0 right-0 p-5">
            <div class="flex items-center justify-between mb-4">
                <h3 class="font-bold text-sm" style="color:var(--text-1);">Lacak Pesanan</h3>
                <button onclick="closeTrack()" class="w-8 h-8 rounded-lg flex items-center justify-center" style="background:#f4f4f5;border:1px solid var(--border);">
                    <iconify-icon icon="mdi:close" style="color:var(--text-2);"></iconify-icon>
                </button>
            </div>
            <div class="space-y-3">
                <input type="text" id="trackCode" placeholder="FX-XXXX-XXXX" class="hm-input font-mono uppercase tracking-widest" maxlength="14" oninput="this.value=this.value.toUpperCase()">
                <button onclick="doTrack()" class="btn btn-primary w-full py-2.5 text-sm">
                    <iconify-icon icon="mdi:magnify"></iconify-icon> Cek Status
                </button>
                <div id="trackResult"></div>
            </div>
        </div>
    </div>

    <!-- ══ MENU DRAWER ══ -->
    <div id="menu-drawer" class="fixed inset-0" style="display:none;z-index:8000;">
        <div id="menu-drawer-overlay" onclick="closeMenu()" class="absolute inset-0" style="background:rgba(0,0,0,.7);animation:fadeIn .2s ease;"></div>
        <div class="side-drawer" id="menu-drawer-content">

            <!-- Header -->
            <div class="flex items-center justify-between p-4" style="border-bottom:1px solid var(--border);">
                <div class="flex items-center gap-2">
                    <img src="<%= settings?.logoUrl || '/uploads/logo-main.png' %>" alt="Logo" style="height:34px;width:34px;object-fit:contain;flex-shrink:0;">
                    <%- include('partials/logo-text', { siteName: settings?.siteName, logoTextUrl: settings?.logoTextUrl, fontSize: '15px' }) %>
                </div>
                <button onclick="closeMenu()" class="w-8 h-8 rounded-lg flex items-center justify-center" style="background:var(--bg-hover);border:1px solid var(--border);">
                    <iconify-icon icon="mdi:close" style="color:var(--text-2);"></iconify-icon>
                </button>
            </div>

            <!-- ══ INFO AKUN (ditulis ulang 23 Agu 2026, diminta client
                 "jelas dan ga berantakan") ══
                 Satu kartu jelas: foto/avatar, nama, badge role (ADMIN/VIP/
                 Member), dan tombol Logout ATAU Login+Daftar langsung di
                 dalam kartu yang sama -- supaya user tidak perlu scroll
                 turun cari tombol logout terpisah dari info akunnya. -->
            <div class="p-4" style="border-bottom:1px solid var(--border);">
                <% if (typeof user !== 'undefined' && user) { %>
                <div class="flex items-center gap-3 p-3 rounded-xl" style="background:var(--bg-hover);border:1px solid var(--border);">
                    <% if (!isAdmin) { %><input type="file" id="avatarInput" accept="image/jpeg,image/png,image/webp" class="hidden" onchange="uploadAvatar(this)"><% } %>
                    <div class="<%= !isAdmin ? 'avatar-wrap' : '' %>" onclick="<%= isAdmin ? '' : "document.getElementById('avatarInput').click()" %>">
                        <div class="w-11 h-11 rounded-full overflow-hidden flex-shrink-0" style="border:1.5px solid var(--border-md);" id="profilePhotoWrap">
                            <% if (user.photo) { %>
                                <img src="<%= user.photo %>" class="w-full h-full object-cover" id="profilePhotoImg">
                            <% } else if (isAdmin) { %>
                                <div class="w-full h-full flex items-center justify-center" style="background:#ea580c;">
                                    <iconify-icon icon="mdi:shield-crown" style="color:#fff;font-size:18px;"></iconify-icon>
                                </div>
                            <% } else { %>
                                <div class="w-full h-full flex items-center justify-center font-black text-sm text-white" style="background:var(--blue);" id="profilePhotoInitial"><%= user.username.charAt(0).toUpperCase() %></div>
                            <% } %>
                        </div>
                        <% if (!isAdmin) { %><div class="avatar-overlay"><iconify-icon icon="mdi:camera" style="color:#fff;font-size:14px;"></iconify-icon></div><% } %>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-1.5 mb-0.5">
                            <div class="text-sm font-bold truncate" style="color:var(--text-1);"><%= user.username %></div>
                            <% if (isAdmin) { %>
                            <span class="text-[8px] font-black px-1.5 py-0.5 rounded flex-shrink-0" style="background:rgba(234,88,12,.2);color:#fb923c;border:1px solid rgba(234,88,12,.3);">ADMIN</span>
                            <% } else if (user.is_reseller) { %>
                            <span class="text-[8px] font-black px-1.5 py-0.5 rounded flex-shrink-0" style="background:rgba(245,158,11,.15);color:#fbbf24;border:1px solid rgba(245,158,11,.25);">VIP</span>
                            <% } %>
                        </div>
                        <div class="text-[10px]" style="color:var(--text-3);">
                            <%= isAdmin ? 'Administrator' : (user.is_reseller ? 'Reseller VIP' : 'Member') %>
                        </div>
                    </div>
                    <a href="/logout" onclick="doLogout(event)" class="flex-shrink-0 w-8 h-8 rounded-lg flex items-center justify-center" style="background:var(--red-dim);color:var(--red);" title="Logout">
                        <iconify-icon icon="mdi:logout" style="font-size:16px;"></iconify-icon>
                    </a>
                </div>
                <% } else { %>
                <div class="flex gap-2">
                    <a href="/login" onclick="closeMenu()" class="flex-1 flex items-center justify-center gap-1.5 py-2.5 rounded-lg text-sm font-bold" style="background:var(--bg-hover);color:var(--text-1);border:1px solid var(--border);">
                        <iconify-icon icon="mdi:login" style="font-size:16px;"></iconify-icon> Masuk
                    </a>
                    <a href="/register" onclick="closeMenu()" class="flex-1 flex items-center justify-center gap-1.5 py-2.5 rounded-lg text-sm font-bold text-white" style="background:var(--blue);">
                        <iconify-icon icon="mdi:account-plus" style="font-size:16px;"></iconify-icon> Daftar
                    </a>
                </div>
                <% } %>
            </div>

            <!-- Nav Links -->
            <div class="p-3 space-y-0.5">
                <a href="/" onclick="closeMenu()" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors" style="color:var(--text-2);" onmouseover="this.style.color='var(--text-1)';this.style.background='var(--bg-hover)'" onmouseout="this.style.color='var(--text-2)';this.style.background='transparent'">
                    <iconify-icon icon="mdi:home-variant" style="color:var(--blue);font-size:18px;"></iconify-icon> Beranda
                </a>
                <a href="/invoice" onclick="closeMenu()" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors" style="color:var(--text-2);" onmouseover="this.style.color='var(--text-1)';this.style.background='var(--bg-hover)'" onmouseout="this.style.color='var(--text-2)';this.style.background='transparent'">
                    <iconify-icon icon="mdi:package-variant-closed" style="color:var(--green);font-size:18px;"></iconify-icon> Cek Pesanan
                </a>
                <% if (typeof user !== 'undefined' && user && !isAdmin) { %>
                <a href="/dashboard" onclick="closeMenu()" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors" style="color:var(--text-2);" onmouseover="this.style.color='var(--text-1)';this.style.background='var(--bg-hover)'" onmouseout="this.style.color='var(--text-2)';this.style.background='transparent'">
                    <iconify-icon icon="mdi:view-dashboard" style="color:var(--blue);font-size:18px;"></iconify-icon> Dashboard
                </a>
                <% } %>

                <% if (!isAdmin) { %>
                    <% if (typeof user !== 'undefined' && user && user.is_reseller) { %>
                    <a href="/reseller" onclick="closeMenu()" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-bold" style="color:#fbbf24;">
                        <iconify-icon icon="mdi:crown" style="font-size:18px;"></iconify-icon>
                        <span class="flex-1">Status VIP</span>
                        <span class="text-[9px] px-1.5 py-0.5 rounded font-black" style="background:rgba(245,158,11,.15);color:#fbbf24;">AKTIF</span>
                    </a>
                    <% } else if (typeof settings !== 'undefined' && settings.resellerEnabled !== false) { %>
                    <a href="/reseller" onclick="closeMenu()" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium" style="color:var(--text-2);" onmouseover="this.style.color='var(--text-1)';this.style.background='var(--bg-hover)'" onmouseout="this.style.color='var(--text-2)';this.style.background='transparent'">
                        <iconify-icon icon="mdi:crown" style="color:var(--amber);font-size:18px;"></iconify-icon> Jadi Reseller VIP
                    </a>
                    <% } %>
                <% } %>

                <% if (isAdmin) { %>
                <a href="/admin" onclick="closeMenu()" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-bold" style="color:#fb923c;" onmouseover="this.style.background='rgba(234,88,12,.06)'" onmouseout="this.style.background='transparent'">
                    <iconify-icon icon="mdi:shield-crown" style="font-size:18px;"></iconify-icon> Admin Panel
                </a>
                <% } %>
            </div>

            <!-- ══ PENGATURAN (baru 23 Agu 2026): toggle mode gelap-terang.
                 Switch polos (BUKAN icon matahari/bulan, diminta client),
                 disimpan ke localStorage lewat toggleDarkMode() di script
                 utama layout ini -- aktif di semua halaman & kondisi
                 (login/guest/admin), bukan cuma di homepage. ══ -->
            <div class="px-3 pb-1">
                <div class="my-1" style="border-top:1px solid var(--border);"></div>
                <div class="flex items-center justify-between px-3 py-2.5">
                    <div class="flex items-center gap-3">
                        <iconify-icon icon="mdi:tune-variant" style="color:var(--text-2);font-size:18px;"></iconify-icon>
                        <span class="text-sm font-medium" style="color:var(--text-2);">Mode Gelap</span>
                    </div>
                    <label class="dark-toggle-switch">
                        <input type="checkbox" id="darkModeToggle" onchange="toggleDarkMode(this)">
                        <span class="dark-toggle-slider"></span>
                    </label>
                </div>
            </div>

            <!-- Kontak -->
            <div class="p-3 space-y-0.5">
                <div class="my-1" style="border-top:1px solid var(--border);"></div>
                <% if (settings?.contact?.whatsapp) { %>
                <a href="https://wa.me/<%= (settings.contact.whatsapp||'').replace(/\D/g,'') %>" target="_blank" onclick="closeMenu()" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm" style="color:var(--text-2);" onmouseover="this.style.color='var(--text-1)';this.style.background='var(--bg-hover)'" onmouseout="this.style.color='var(--text-2)';this.style.background='transparent'">
                    <iconify-icon icon="mdi:whatsapp" style="color:var(--brand-wa);font-size:18px;"></iconify-icon> Hubungi CS (WA)
                </a>
                <% } %>
                <% if (settings?.contact?.waChannel) { %>
                <a href="<%= settings.contact.waChannel %>" target="_blank" onclick="closeMenu()" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm" style="color:var(--text-2);" onmouseover="this.style.color='var(--text-1)';this.style.background='var(--bg-hover)'" onmouseout="this.style.color='var(--text-2)';this.style.background='transparent'">
                    <iconify-icon icon="mdi:broadcast" style="color:var(--brand-wa);font-size:18px;"></iconify-icon> Saluran WA
                </a>
                <% } %>
                <% if (settings?.contact?.telegram) { %>
                <a href="https://t.me/<%= settings.contact.telegram %>" target="_blank" onclick="closeMenu()" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm" style="color:var(--text-2);" onmouseover="this.style.color='var(--text-1)';this.style.background='var(--bg-hover)'" onmouseout="this.style.color='var(--text-2)';this.style.background='transparent'">
                    <iconify-icon icon="mdi:telegram" style="color:#f87171;font-size:18px;"></iconify-icon> Telegram
                </a>
                <% } %>
            </div>

            <div class="px-4 pb-6 pt-2 text-center text-[10px]" style="color:var(--text-3);">
                &copy; 2026 <%= settings?.siteName || 'AGHA NL' %>
            </div>
        </div>
    </div>

    <script>
    // ─── LOGOUT ───
    function doLogout(e) {
        e.preventDefault();
        localStorage.removeItem('vpr_cart');
        localStorage.removeItem('vpr_notifs');
        window.location.href = '/logout';
    }

    // ─── DARK MODE TOGGLE ───
    // Toggle switch (bukan icon matahari/bulan, diminta client 23 Agu
    // 2026) di menu hamburger. Simpan pilihan ke localStorage supaya
    // konsisten di semua halaman & kunjungan berikutnya -- pembacaan
    // awal (mencegah flash) ada di <head>, ini cuma untuk toggle manual.
    function toggleDarkMode(checkboxEl) {
        const isDark = checkboxEl.checked;
        document.documentElement.classList.toggle('dark', isDark);
        try { localStorage.setItem('fz-theme', isDark ? 'dark' : 'light'); } catch (e) {}
    }
    // Sinkronkan posisi switch di menu dengan state aktif saat drawer dibuka
    // (drawer ada di semua halaman, jadi ini jalan otomatis di mana saja).
    document.addEventListener('DOMContentLoaded', () => {
        const toggle = document.getElementById('darkModeToggle');
        if (toggle) toggle.checked = document.documentElement.classList.contains('dark');
    });

    // ─── TOAST ───
    function showToast(msg, type='info') {
        const c = document.getElementById('toast-container');
        if (!c) return;
        const icon = {success:'mdi:check-circle',error:'mdi:alert-circle',info:'mdi:information'}[type]||'mdi:information';
        const clr  = {success:'var(--green)',error:'var(--red)',info:'var(--blue)'}[type]||'var(--blue)';
        const t = document.createElement('div');
        t.className = 'toast';
        t.innerHTML = `<iconify-icon icon="${icon}" style="color:${clr};font-size:16px;flex-shrink:0;"></iconify-icon><span>${msg}</span>`;
        c.appendChild(t);
        setTimeout(() => { t.style.opacity='0'; t.style.transition='opacity .3s'; setTimeout(()=>t.remove(),300); }, 3200);
    }

    // ─── NAVBAR SCROLL ───
    window.addEventListener('scroll', () => {
        const n = document.getElementById('navbar');
        if (n) n.classList.toggle('scrolled', window.scrollY > 10);
    }, {passive:true});

    // ─── PANELS ───
    function _closeSearch() { const p=document.getElementById('search-panel'); p.style.display='none'; document.body.classList.remove('no-scroll'); }
    function _closeCart()   { const p=document.getElementById('cart-panel');   p.style.display='none'; document.body.classList.remove('no-scroll'); }
    function _closeTrack()  { document.getElementById('track-panel').classList.add('hidden'); document.body.classList.remove('no-scroll'); }
    function _closeMenu()   { const p=document.getElementById('menu-drawer');  p.style.display='none'; document.body.classList.remove('no-scroll'); }

    function openSearch() {
        const p = document.getElementById('search-panel');
        p.style.display = 'flex';
        document.body.classList.add('no-scroll');
        if (!allProducts.length) fetch('/api/products').then(r=>r.json()).then(d=>allProducts=d);
        setTimeout(() => document.getElementById('searchInput')?.focus(), 80);
    }
    function closeSearch() { _closeSearch(); }

    function openCart() {
        renderCart();
        const p = document.getElementById('cart-panel');
        p.style.display = 'block';
        document.body.classList.add('no-scroll');
    }
    function closeCart() { _closeCart(); }

    function openTrack() {
        document.getElementById('track-panel').classList.remove('hidden');
        document.body.classList.add('no-scroll');
    }
    function closeTrack() { _closeTrack(); }

    function openMenu() {
        const p = document.getElementById('menu-drawer');
        p.style.display = 'block';
        const d = document.getElementById('menu-drawer-content');
        d.style.animation = 'none';
        void d.offsetWidth;
        d.style.animation = 'slideRight .22s ease both';
        document.body.classList.add('no-scroll');
    }
    function closeMenu() { _closeMenu(); }

    function closeAll() { _closeSearch(); _closeCart(); _closeTrack(); _closeMenu(); }

    // ─── SEARCH ───
    let allProducts = [];
    function doSearch(q) {
        const rs = document.getElementById('searchResults');
        if (!q.trim()) {
            rs.innerHTML = '<div class="text-center py-16" style="color:var(--text-3);"><iconify-icon icon="mdi:magnify" style="font-size:36px;" class="block mb-2"></iconify-icon><p class="text-sm">Ketik untuk mencari...</p></div>';
            return;
        }
        const f = allProducts.filter(p => p.name.toLowerCase().includes(q.toLowerCase()) || (p.category||'').toLowerCase().includes(q.toLowerCase()));
        if (!f.length) {
            rs.innerHTML = '<div class="text-center py-16" style="color:var(--text-3);"><iconify-icon icon="mdi:emoticon-sad-outline" style="font-size:36px;" class="block mb-2"></iconify-icon><p class="text-sm">Tidak ditemukan</p></div>';
            return;
        }
        rs.innerHTML = f.map(p => `
            <a href="/buy/${p.id}" class="flex items-center gap-3 p-3 rounded-xl mb-2 transition-colors block" style="border:1px solid var(--border);" onmouseover="this.style.background='var(--bg-hover)'" onmouseout="this.style.background='transparent'">
                <div class="w-11 h-11 rounded-lg overflow-hidden flex-shrink-0" style="background:var(--bg-hover);border:1px solid var(--border);">
                    ${p.image ? `<img src="${p.image}" class="w-full h-full object-cover">` : `<div class="w-full h-full flex items-center justify-center"><iconify-icon icon="mdi:gamepad-variant" style="color:var(--blue);font-size:18px;"></iconify-icon></div>`}
                </div>
                <div class="flex-1 min-w-0">
                    <div class="font-semibold text-sm truncate" style="color:var(--text-1);">${p.name}</div>
                    <div class="text-xs mt-0.5" style="color:var(--text-3);">${p.category||''}</div>
                    <div class="text-xs font-bold mt-0.5" style="color:var(--blue);">${p.items?.[0]?'Rp '+p.items[0].p.toLocaleString('id-ID'):''}</div>
                </div>
                <iconify-icon icon="mdi:chevron-right" style="color:var(--text-3);"></iconify-icon>
            </a>`).join('');
    }

    // ─── CART ───
    let cart = JSON.parse(localStorage.getItem('vpr_cart') || '[]');
    function updateCartBadge() {
        const b = document.getElementById('cart-badge');
        if (!b) return;
        if (cart.length > 0) { b.textContent = cart.length; b.style.display = 'flex'; }
        else b.style.display = 'none';
    }
    function renderCart() {
        const el = document.getElementById('cartItems');
        if (!cart.length) {
            el.innerHTML = '<div class="text-center py-10" style="color:var(--text-3);"><iconify-icon icon="mdi:cart-outline" style="font-size:40px;" class="block mb-2"></iconify-icon><p class="text-sm">Keranjang kosong</p><a href="/" class="text-xs mt-2 inline-block" style="color:var(--blue);">Lihat produk</a></div>';
            return;
        }
        el.innerHTML = cart.map((item,i) => `
            <div class="card p-3 flex items-center gap-3">
                <div class="w-11 h-11 rounded-lg overflow-hidden flex-shrink-0" style="background:var(--bg-hover);border:1px solid var(--border);">
                    ${item.image ? `<img src="${item.image}" class="w-full h-full object-cover">` : `<iconify-icon icon="mdi:gamepad-variant" style="color:var(--blue);font-size:18px;"></iconify-icon>`}
                </div>
                <div class="flex-1 min-w-0">
                    <div class="font-semibold text-xs truncate" style="color:var(--text-1);">${item.name}</div>
                    <div class="text-[11px] mt-0.5" style="color:var(--text-3);">${item.duration}</div>
                    <div class="text-xs font-bold mt-0.5" style="color:var(--blue);">Rp ${item.price.toLocaleString('id-ID')}</div>
                </div>
                <button onclick="removeFromCart(${i})" class="w-8 h-8 rounded-lg flex items-center justify-center" style="background:var(--red-dim);border:1px solid rgba(239,68,68,.2);">
                    <iconify-icon icon="mdi:trash-can-outline" style="color:var(--red);font-size:14px;"></iconify-icon>
                </button>
            </div>`).join('') + `
            <a href="/buy/${cart[0]?.productId}" class="btn btn-primary w-full py-2.5 mt-3 text-sm">
                <iconify-icon icon="mdi:lightning-bolt"></iconify-icon> Lanjut Beli
            </a>`;
    }
    function addToCart(item) {
        cart.push(item);
        localStorage.setItem('vpr_cart', JSON.stringify(cart));
        updateCartBadge();
        showToast('Ditambahkan ke keranjang', 'success');
    }
    function removeFromCart(i) {
        cart.splice(i, 1);
        localStorage.setItem('vpr_cart', JSON.stringify(cart));
        updateCartBadge();
        renderCart();
    }

    // ─── TRACK ───
    async function doTrack() {
        const code = document.getElementById('trackCode').value.trim().toUpperCase();
        const rd = document.getElementById('trackResult');
        if (!code) { showToast('Masukkan kode pesanan', 'error'); return; }
        rd.innerHTML = '<div class="text-center py-4"><iconify-icon icon="mdi:loading" style="color:var(--blue);font-size:20px;" class="animate-spin"></iconify-icon></div>';
        try {
            const r = await fetch('/invoice', {method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body:`code=${code}`});
            const html = await r.text();
            const doc = new DOMParser().parseFromString(html, 'text/html');
            const trx = doc.querySelector('.p-4.rounded-lg');
            if (trx) { rd.innerHTML = `<div class="card p-4 mt-3">${trx.innerHTML}</div>`; }
            else rd.innerHTML = '<div class="card p-3 mt-3 text-xs" style="color:var(--red);">Kode pesanan tidak ditemukan</div>';
        } catch(e) {
            rd.innerHTML = '<div class="card p-3 mt-3 text-xs" style="color:var(--red);">Gagal mengambil data</div>';
        }
    }

    // ─── AVATAR UPLOAD ───
    async function uploadAvatar(input) {
        const file = input.files[0];
        if (!file) return;
        if (file.size > 2*1024*1024) { showToast('Maks 2MB', 'error'); return; }
        const fd = new FormData();
        fd.append('photo', file);
        try {
            showToast('Mengupload...', 'info');
            const r = await fetch('/profile/photo', {method:'POST', body:fd});
            const d = await r.json();
            if (d.success) {
                const wrap = document.getElementById('profilePhotoWrap');
                if (wrap) wrap.innerHTML = `<img src="${d.photo}?t=${Date.now()}" class="w-full h-full object-cover">`;
                showToast('Foto berhasil diperbarui', 'success');
            } else showToast(d.message || 'Gagal upload', 'error');
        } catch(e) { showToast('Gagal upload foto', 'error'); }
        input.value = '';
    }

    // ─── PURCHASE NOTIF ───
    let shownNotifIds = new Set(JSON.parse(localStorage.getItem('vpr_notifs')||'[]'));
    let notifQueue = [], notifPlaying = false;
    async function loadPurchaseNotifs() {
        try {
            const r = await fetch('/api/notifications');
            const notifs = await r.json();
            notifs.forEach(n => { if (!shownNotifIds.has(n.id)) { notifQueue.push(n); shownNotifIds.add(n.id); } });
            localStorage.setItem('vpr_notifs', JSON.stringify([...shownNotifIds].slice(-100)));
            if (!notifPlaying && notifQueue.length) playNextNotif();
        } catch(e) {}
    }
    function playNextNotif() {
        if (!notifQueue.length) { notifPlaying = false; return; }
        notifPlaying = true;
        showPurchaseNotif(notifQueue.shift());
        setTimeout(playNextNotif, 4500);
    }
    function showPurchaseNotif(n) {
        const c = document.getElementById('purchase-notif-container');
        if (!c) return;
        const bg = ['#b91c1c','#0891b2','#15803d','#ea580c','#7c3aed'][n.buyerName.charCodeAt(0)%5];
        const avatarHtml = n.buyerPhoto
            ? `<img src="${n.buyerPhoto}" class="w-full h-full object-cover" style="border-radius:8px;">`
            : `<div class="purchase-notif-avatar" style="background:${bg};">${n.buyerName.charAt(0).toUpperCase()}</div>`;
        const el = document.createElement('div');
        el.className = 'purchase-notif';
        el.innerHTML = `${avatarHtml}<div class="purchase-notif-text"><div class="purchase-notif-name">${n.buyerName} baru saja beli</div><div class="purchase-notif-product">${n.productName}</div></div><div class="purchase-notif-price">Rp ${n.price.toLocaleString('id-ID')}</div>`;
        c.appendChild(el);
        setTimeout(() => { el.style.opacity='0'; el.style.transition='opacity .3s'; setTimeout(()=>el.remove(),300); }, 3800);
    }



    // ─── PAYMENT / SOCIAL ICON BUG FIX ───
    // Keeps footer social icons perfectly centered and upgrades the
    // "Metode Pembayaran" strip to real logo cards without requiring
    // another template file. The logo sources are public SVG/CDN assets.
    function enhancePaymentMethods() {
        // 1) Force-centering for any footer social icon that uses Iconify.
        document.querySelectorAll('footer a iconify-icon, footer button iconify-icon, .footer-social iconify-icon').forEach(icon => {
            const parent = icon.parentElement;
            if (!parent) return;
            parent.style.display = 'inline-flex';
            parent.style.alignItems = 'center';
            parent.style.justifyContent = 'center';
            parent.style.lineHeight = '0';
            icon.style.display = 'block';
            icon.style.lineHeight = '1';
            icon.style.margin = '0';
            icon.style.transform = 'none';
        });

        // 2) Locate the payment-method section by its visible heading.
        const heading = [...document.querySelectorAll('h1,h2,h3,h4,h5,h6,p,span,div')].find(el => {
            const t = (el.textContent || '').trim().toUpperCase();
            return t === 'METODE PEMBAYARAN';
        });
        if (!heading) return;

        // Avoid injecting twice.
        if (heading.parentElement?.querySelector('.payment-logo-list[data-enhanced="1"]')) return;

        // Find the nearest container that actually contains payment controls.
        let scope = heading.parentElement;
        for (let i = 0; i < 5 && scope; i++, scope = scope.parentElement) {
            const labels = [...scope.querySelectorAll('button,a,[role="button"],span,div')].map(x => (x.textContent || '').trim().toLowerCase());
            if (labels.some(t => /^(qris|transfer bank|e-?wallet)$/.test(t))) break;
        }
        if (!scope) return;

        const targets = [...scope.querySelectorAll('button,a,[role="button"]')].filter(el => {
            const t = (el.textContent || '').trim().toLowerCase();
            return /^(qris|transfer bank|e-?wallet)$/.test(t);
        });
        if (!targets.length) return;

        const row = document.createElement('div');
        row.className = 'payment-logo-list';
        row.dataset.enhanced = '1';
        row.innerHTML = `
            <div class="payment-logo-card" title="QRIS">
                <img src="https://cdn.jsdelivr.net/npm/idn-finlogos@2/dist/icons/qris.svg" alt="QRIS" loading="lazy">
            </div>
            <div class="payment-logo-card" title="DANA">
                <img src="https://cdn.jsdelivr.net/npm/idn-finlogos@2/dist/icons/dana.svg" alt="DANA" loading="lazy">
            </div>
            <div class="payment-logo-card" title="GoPay">
                <img src="https://cdn.jsdelivr.net/npm/idn-finlogos@2/dist/icons/gopay.svg" alt="GoPay" loading="lazy">
            </div>
            <div class="payment-logo-card" title="OVO">
                <img src="https://cdn.jsdelivr.net/npm/idn-finlogos@2/dist/icons/ovo.svg" alt="OVO" loading="lazy">
            </div>
            <div class="payment-logo-card" title="ShopeePay">
                <img src="https://cdn.jsdelivr.net/npm/idn-finlogos@2/dist/icons/shopee-pay.svg" alt="ShopeePay" loading="lazy">
            </div>
            <div class="payment-logo-card" title="LinkAja">
                <img src="https://cdn.jsdelivr.net/npm/idn-finlogos@2/dist/icons/linkaja.svg" alt="LinkAja" loading="lazy">
            </div>
            <div class="payment-logo-card payment-logo-card--bank" title="Transfer Bank">
                <iconify-icon icon="mdi:bank-transfer"></iconify-icon>
                <span>Transfer Bank</span>
            </div>`;

        // Replace the old pill-style controls with the logo strip.
        const first = targets[0];
        const targetContainer = first.parentElement;
        targets.forEach(el => el.remove());
        targetContainer?.appendChild(row);
    }

    // ─── INIT ───
    document.addEventListener('DOMContentLoaded', () => {
        updateCartBadge();
        enhancePaymentMethods();
        setTimeout(() => { loadPurchaseNotifs(); setInterval(loadPurchaseNotifs, 30000); }, 2000);
    });
    document.addEventListener('keydown', e => { if (e.key==='Escape') closeAll(); });
    document.addEventListener('click', e => {
        const a = e.target.closest('a[href]');
        if (!a) return;
        const href = a.getAttribute('href');
        if (!href || href.startsWith('#') || href.startsWith('javascript') || a.target==='_blank') return;
        if (a.getAttribute('onclick') || e.defaultPrevented) return;
        e.preventDefault();
        document.body.style.transition = 'opacity .15s';
        document.body.style.opacity = '0';
        setTimeout(() => { window.location.href = href; }, 150);
    });
    </script>
</body>
</html>
